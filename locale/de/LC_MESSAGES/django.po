msgid_plural "%(n)s overdue"
msgstr[0] "%(n)s überfällig"
msgstr[1] "%(n)s überfällig"

msgid "%(n)s debt"
msgid_plural "%(n)s debts"
msgstr[0] "%(n)s Schulden"
msgstr[1] "%(n)s Schulden"

msgid "%(n)s debt is past its pay-back date."
msgid_plural "%(n)s debts are past their pay-back date."
msgstr[0] "%(n)s Schulden haben das Rückzahlungsdatum überschritten."
msgstr[1] "%(n)s Schulden haben ihr Rückzahlungsdatum überschritten."
