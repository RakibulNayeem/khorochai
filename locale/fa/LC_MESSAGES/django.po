msgstr "این رمز عبور خیلی رایج است."

msgid "This password is entirely numeric."
msgstr "این رمز عبور کاملاً عددی است."

msgid "The password is too similar to the %(verbose_name)s."
msgstr "رمز عبور بیش از حد به %(verbose_name)s شبیه است."

msgid "Your password can’t be too similar to your other personal information."
msgstr "رمز عبور شما نمی‌تواند بیش از حد به اطلاعات شخصی دیگرتان شبیه باشد."

msgid "Your password can’t be a commonly used password."
msgstr "رمز عبور شما نمی‌تواند یک رمز رایج باشد."

msgid "Your password can’t be entirely numeric."
msgstr "رمز عبور شما نمی‌تواند کاملاً عددی باشد."

msgid "Continue with %(provider)s"
msgstr "ادامه با %(provider)s"

msgid "or with email"
msgstr "یا با ایمیل"

msgid "You'll get ready-made categories and accounts to start with. We'll email you a 6-digit code to confirm your email."
msgstr "برای شروع، دسته‌بندی‌ها و حساب‌های آماده دریافت خواهید کرد. ما یک کد ۶ رقمی برای تأیید ایمیلتان ارسال می‌کنیم."

msgid "Profile"
msgstr "پروفایل"

msgid "Email (used to log in)"
msgstr "ایمیل (برای ورود استفاده می‌شود)"

msgid "Change email"
msgstr "تغییر ایمیل"

msgid "Change password"
msgstr "تغییر رمز عبور"

msgid "Google / Facebook login"
msgstr "ورود با Google / Facebook"

msgid "Shown in the app. You log in with your email, not this."
msgstr "در برنامه نمایش داده می‌شود. شما با ایمیل خود وارد می‌شوید، نه با این."

msgid "This username is already taken."
msgstr "این نام کاربری قبلاً انتخاب شده است."

msgid "Username updated."
msgstr "نام کاربری به‌روزرسانی شد."

msgid "Hello from KhorochAi!"
msgstr "سلام از KhorochAi!"

msgid "Thank you for using KhorochAi."
msgstr "از اینکه از KhorochAi استفاده می‌کنید متشکریم."

msgid "Your email verification code is:"
msgstr "کد تأیید ایمیل شما این است:"

msgid "Enter it in the KhorochAi page that is open in your browser. The code expires soon."
msgstr "آن را در صفحه KhorochAi که در مرورگر شما باز است وارد کنید. کد به زودی منقضی می‌شود."

msgid "To confirm your email, open %(activate_url)s"
msgstr "برای تایید ایمیل خود، %(activate_url)s را باز کنید"

msgid "If you did not sign up for KhorochAi, you can ignore this email."
msgstr "اگر در KhorochAi ثبت‌نام نکرده‌اید، می‌توانید این ایمیل را نادیده بگیرید."

msgid "Your verification code"
msgstr "کد تأیید شما"

msgid "Your password reset code is:"
msgstr "کد بازنشانی رمز عبور شما این است:"

msgid "If you did not ask to reset your password, you can ignore this email. Your password has not changed."
msgstr "اگر درخواست بازنشانی رمز عبور نداده‌اید، می‌توانید این ایمیل را نادیده بگیرید. رمز عبور شما تغییر نکرده است."

msgid "Your password reset code"
msgstr "کد بازنشانی رمز عبور شما"

msgid "Set balance"
msgstr "تنظیم موجودی"

msgid "Balance now"
msgstr "موجودی فعلی"

msgid "Balance updated: %(list)s."
msgstr "موجودی به‌روزرسانی شد: %(list)s."

msgid "Good morning, %(name)s"
msgstr "صبح بخیر، %(name)s"

msgid "Good afternoon, %(name)s"
msgstr "بعد از ظهر بخیر، %(name)s"

msgid "Good evening, %(name)s"
msgstr "عصر بخیر، %(name)s"

msgid "Speak instead of typing"
msgstr "به جای تایپ کردن، صحبت کنید"

msgid "Stop recording"
msgstr "توقف ضبط"

msgid "Writing what you said…"
msgstr "در حال نوشتن آنچه گفتید..."

msgid "Microphone access is blocked. Allow it in your browser settings and try again."
msgstr "دسترسی به میکروفون مسدود شده است. در تنظیمات مرورگر آن را مجاز کنید و دوباره تلاش کنید."

msgid "That was too short. Hold on a moment and speak, then tap stop."
msgstr "خیلی کوتاه بود. لحظه‌ای صبر کنید و صحبت کنید، سپس توقف را بزنید."

msgid "Could not send the recording. Check your connection and try again."
msgstr "ارسال ضبط ممکن نبود. اتصال خود را بررسی کرده و دوباره تلاش کنید."

msgid "No recording was received."
msgstr "هیچ رکوردی دریافت نشد."

msgid "The recording is too long. Please keep it under a minute."
msgstr "ضبط خیلی طولانی است. لطفاً آن را زیر یک دقیقه نگه دارید."

msgid "Couldn't turn the recording into text right now. Please try again or type it."
msgstr "در حال حاضر امکان تبدیل ضبط به متن وجود ندارد. لطفاً دوباره تلاش کنید یا آن را تایپ کنید."

msgid "I couldn't hear anything. Please try again a little closer to the mic."
msgstr "صدایی شنیده نشد. لطفاً کمی نزدیک‌تر به میکروفون دوباره تلاش کنید."

msgid "Set budget"
msgstr "تعیین بودجه"

msgid "Monthly budget set: %(list)s."
msgstr "بودجه ماهانه تنظیم شد: %(list)s."

msgid "%(name)s (removed)"
msgstr "%(name)s (حذف شده)"

msgid "Help & contact"
msgstr "راهنما و تماس"

msgid "Everything works by typing or speaking in plain English, বাংলা or Banglish. You always see a preview before anything is saved."
msgstr "همه چیز با تایپ کردن یا صحبت کردن به زبان‌های ساده English, বাংলা یا Banglish کار می‌کند. شما همیشه قبل از ذخیره شدن هر چیزی، پیش‌نمایش آن را می‌بینید."

msgid "How to use KhorochAi"
msgstr "نحوه استفاده از KhorochAi"

msgid "Good to know"
msgstr "دانستنی‌های مفید"

msgid "The AI only reads your text; every total and balance is calculated by the app from your saved data."
msgstr "AI فقط متن شما را می‌خواند؛ هر مجموع و موجودی توسط برنامه از داده‌های ذخیره‌شده شما محاسبه می‌شود."

msgid "AI use has a daily allowance, shown on the dashboard. It resets at midnight, and you can always add things manually."
msgstr "استفاده از AI سهمیه روزانه دارد که در داشبورد نشان داده می‌شود. این سهمیه نیمه‌شب بازنشانی می‌شود و همیشه می‌توانید مواردی را به‌صورت دستی اضافه کنید."

msgid "Never type card numbers or passwords."
msgstr "هرگز شماره کارت یا رمز عبور را تایپ نکنید."

msgid "Change the theme, language and your username from the menu at the top right."
msgstr "تم، زبان و نام کاربری خود را از منوی بالا سمت راست تغییر دهید."

msgid "Contact"
msgstr "تماس"

msgid "Questions, problems or ideas"
msgstr "سوالات، مشکلات یا ایده‌ها"

msgid "Write to us and we'll get back to you."
msgstr "برای ما بنویسید و ما به شما پاسخ خواهیم داد."

msgid "Developer"
msgstr "توسعه‌دهنده"

msgid "KhorochAi is built by %(name)s."
msgstr "KhorochAi توسط %(name)s ساخته شده است."

msgid "Account menu"
msgstr "منوی حساب"

msgid "First name"
msgstr "نام"

msgid "Shown in the greeting and the menu."
msgstr "در خوش‌آمدگویی و منو نمایش داده می‌شود."

msgid "Profile updated."
msgstr "پروفایل به‌روزرسانی شد."

msgid "Add spending or income"
msgstr "افزودن هزینه یا درآمد"

msgid "Type what happened in the box on the dashboard and press Add with AI."
msgstr "آنچه اتفاق افتاده را در کادر داشبورد تایپ کنید و «Add with AI» را بزنید."

msgid "Tap the mic in the box, talk, then tap stop. Check the text, then press Add with AI."
msgstr "روی میکروفون در کادر ضربه بزنید، صحبت کنید، سپس توقف را بزنید. متن را بررسی کنید و دکمه افزودن با AI را فشار دهید."

msgid "Accounts and moving money"
msgstr "حساب‌ها و انتقال پول"

msgid "Say which account you used, or move money between your own accounts."
msgstr "بگویید از کدام حساب استفاده کردید، یا پول را بین حساب‌های خود جابجا کنید."

msgid "Set an account balance"
msgstr "تعیین موجودی حساب"

msgid "Tell the AI how much is in an account right now."
msgstr "به AI بگویید در حال حاضر چقدر در یک حساب موجودی دارید."

msgid "Monthly budgets"
msgstr "بودجه‌های ماهانه"

msgid "Set a spending limit for a category and watch the progress bar on the dashboard."
msgstr "برای یک دسته‌بندی سقف هزینه تعیین کنید و نوار پیشرفت را در داشبورد ببینید."

msgid "Ask about your money"
msgstr "درباره پول خود بپرسید"

msgid "Use Ask AI for totals, breakdowns and comparisons."
msgstr "برای مشاهده مجموع، تفکیک و مقایسه از Ask AI استفاده کنید."

msgid "Portfolio"
msgstr "پورتفولیو"

msgid "Help"
msgstr "راهنما"

msgid "About & contact"
msgstr "درباره ما و تماس"

msgid "Made by"
msgstr "ساخته شده توسط"

msgid "Developer, KhorochAi"
msgstr "توسعه‌دهنده، KhorochAi"

msgid "How can we help?"
msgstr "چطور می‌توانیم کمک کنیم؟"

msgid "Still need help?"
msgstr "هنوز به کمک نیاز دارید؟"

msgid "Write to us — questions, problems and ideas are all welcome."
msgstr "برای ما بنویسید — سوالات، مشکلات و ایده‌ها همگی استقبال می‌شوند."

msgid "Contact us"
msgstr "تماس با ما"

msgid "Money tracking that speaks your language"
msgstr "مدیریت مالی که به زبان شما صحبت می‌کند"

msgid "KhorochAi lets you track spending and income just by typing or speaking — in English, বাংলা or Banglish. The AI understands what you mean; the app does all the maths."
msgstr "KhorochAi به شما امکان می‌دهد هزینه‌ها و درآمدهای خود را فقط با تایپ یا صحبت کردن به زبان‌های انگلیسی، বাংলা یا Banglish ثبت کنید. هوش مصنوعی منظور شما را می‌فهمد و برنامه محاسبات را انجام می‌دهد."

msgid "Type or talk"
msgstr "تایپ کنید یا صحبت کنید"

msgid "No forms to fill. Say “aaj lunch 250 bkash e” and it's recorded."
msgstr "نیازی به پر کردن فرم نیست. بگویید “aaj lunch 250 bkash e” و ثبت می‌شود."

msgid "See where it goes"
msgstr "ببینید پول کجا می‌رود"

msgid "Accounts, budgets and charts show your money at a glance, and Ask AI answers your questions."
msgstr "حساب‌ها، بودجه‌ها و نمودارها وضعیت مالی شما را در یک نگاه نشان می‌دهند و Ask AI به سوالات شما پاسخ می‌دهد."

msgid "Correct by design"
msgstr "طراحی دقیق"

msgid "You check every entry before it's saved, and totals are always calculated from your own data."
msgstr "شما هر ورودی را قبل از ذخیره بررسی می‌کنید و مجموع‌ها همیشه از داده‌های خودتان محاسبه می‌شوند."

msgid "Questions, problems or ideas — write to us and we'll get back to you."
msgstr "سوالات، مشکلات یا ایده‌ها — برای ما بنویسید و ما به شما پاسخ خواهیم داد."

msgid "Read the help guide"
msgstr "راهنمای کمک را بخوانید"

msgid "KhorochAi — Expense & income tracker you can talk to"
msgstr "KhorochAi — ردیاب هزینه و درآمد با قابلیت گفتگو"

msgid "Just say it. Your hisab is done."
msgstr "فقط بگویید. حساب شما انجام شد."

msgid "Just say it. Your hisab is done. Track spending and income by typing or speaking in English, বাংলা or Banglish."
msgstr "فقط بگویید. حساب شما انجام شد. هزینه‌ها و درآمدهای خود را با تایپ یا صحبت به انگلیسی، বাংলা یا Banglish ثبت کنید."

msgid "Free · English, বাংলা & Banglish"
msgstr "رایگان · انگلیسی، বাংলা و Banglish"

msgid "Type or speak what you spent or earned — like you'd tell a friend. KhorochAi turns it into neat entries, keeps your accounts and budgets up to date, and answers your money questions."
msgstr "آنچه خرج یا کسب کرده‌اید را تایپ کنید یا بگویید — مثل اینکه به یک دوست می‌گویید. KhorochAi آن را به ورودی‌های مرتب تبدیل می‌کند، حساب‌ها و بودجه‌های شما را به‌روز نگه می‌دارد و به سوالات مالی شما پاسخ می‌دهد."

msgid "Create free account"
msgstr "ایجاد حساب رایگان"

msgid "Sign up with your email. You check every entry before it's saved."
msgstr "با ایمیل خود ثبت‌نام کنید. شما هر ورودی را قبل از ذخیره شدن بررسی می‌کنید."

msgid "Write it the way you talk"
msgstr "همان‌طور که صحبت می‌کنید بنویسید"

msgid "One message can hold several entries — spending, income, transfers between your accounts, even budgets. The AI reads it; you check the preview and save."
msgstr "یک پیام می‌تواند شامل چندین ورودی باشد — هزینه‌ها، درآمدها، انتقال بین حساب‌ها و حتی بودجه‌ها. هوش مصنوعی آن را می‌خواند؛ شما پیش‌نمایش را بررسی و ذخیره کنید."

msgid "How it works"
msgstr "چگونه کار می‌کند"

msgid "Type or say it"
msgstr "تایپ کنید یا بگویید"

msgid "Write or speak what happened, in English, বাংলা or Banglish. Several things in one message is fine."
msgstr "آنچه اتفاق افتاده را به انگلیسی، বাংলা یا Banglish بنویسید یا بگویید. چندین مورد در یک پیام اشکالی ندارد."

msgid "Check the preview"
msgstr "پیش‌نمایش را بررسی کنید"

msgid "See exactly what the AI understood — amount, category, account and date. Fix anything with a tap."
msgstr "دقیقاً ببینید AI چه چیزی را متوجه شده است — مبلغ، دسته‌بندی، حساب و تاریخ. هر چیزی را با یک ضربه اصلاح کنید."

msgid "Saved and up to date"
msgstr "ذخیره شد و به‌روز است"

msgid "Your totals, account balances, budgets and charts update instantly."
msgstr "مجموع‌ها، موجودی حساب‌ها، بودجه‌ها و نمودارهای شما فوراً به‌روزرسانی می‌شوند."

msgid "Everything you need, nothing you don't"
msgstr "هر آنچه نیاز دارید، بدون موارد اضافی"

msgid "Voice input"
msgstr "ورودی صوتی"

msgid "Tap the mic and speak. Your words appear in the box for you to check."
msgstr "روی میکروفون ضربه بزنید و صحبت کنید. کلمات شما در کادر ظاهر می‌شوند تا بررسی کنید."

msgid "Your language"
msgstr "زبان شما"

msgid "English, বাংলা or Banglish — and the whole app can switch to Bangla."
msgstr "English, বাংলা یا Banglish — و کل برنامه می‌تواند به Bangla تغییر کند."

msgid "All your accounts"
msgstr "تمام حساب‌های شما"

msgid "Cash, bKash, Nagad, Rocket, bank and card, with transfers between them."
msgstr "نقد، bKash، Nagad، Rocket، بانک و کارت، با امکان انتقال بین آن‌ها."

msgid "Set limits per category and watch the progress bars as you spend."
msgstr "برای هر دسته‌بندی محدودیت تعیین کنید و هنگام خرج کردن، نوارهای پیشرفت را مشاهده کنید."

msgid "“এই মাসে খাবারে কত খরচ হলো?” — get the answer from your own data."
msgstr "«এই মাসে খাবারে কত খরচ হলো?» — پاسخ را از داده‌های خود دریافت کنید."

msgid "Clear dashboard"
msgstr "پاک‌سازی داشبورد"

msgid "Income, expense, balance, where your money went and day-by-day charts."
msgstr "درآمد، هزینه، موجودی، محل خرج پول و نمودارهای روزانه."

msgid "Light and dark"
msgstr "روشن و تیره"

msgid "A calm design that follows your phone's dark mode, or pick your own."
msgstr "طراحی آرام که با حالت تاریک گوشی شما هماهنگ می‌شود، یا می‌توانید خودتان انتخاب کنید."

msgid "Export to CSV"
msgstr "خروجی به CSV"

msgid "Download your transactions for Excel or Google Sheets any time."
msgstr "تراکنش‌های خود را هر زمان که بخواهید برای Excel یا Google Sheets دانلود کنید."

msgid "Start your hisab in a minute"
msgstr "حساب و کتاب خود را در یک دقیقه شروع کنید"

msgid "Create a free account with your email, then just tell KhorochAi what you spent today."
msgstr "با ایمیل خود یک حساب رایگان بسازید، سپس فقط به KhorochAi بگویید امروز چقدر خرج کرده‌اید."

msgid "See how it works"
msgstr "ببینید چطور کار می‌کند"

msgid "Free to use"
msgstr "استفاده رایگان"

msgid "You confirm every entry"
msgstr "شما هر ورودی را تایید می‌کنید"

msgid "Works on phone and computer"
msgstr "قابل استفاده در گوشی و کامپیوتر"

msgid "Write it the way you talk — or just talk."
msgstr "همان‌طور که صحبت می‌کنید بنویسید — یا فقط صحبت کنید."

msgid "Type it, or tap the mic and say it. One message can hold several entries — spending, income, transfers between your accounts, even budgets. You check the preview and save."
msgstr "آن را تایپ کنید یا روی میکروفون بزنید و بگویید. یک پیام می‌تواند شامل چندین ورودی باشد — هزینه‌ها، درآمد، انتقال بین حساب‌ها، و حتی بودجه‌ها. شما پیش‌نمایش را بررسی و ذخیره می‌کنید."

msgid "Free · বাংলা, English, Banglish & any language"
msgstr "رایگان · বাংলা، انگلیسی، Banglish و هر زبان دیگر"

msgid "Write it the way you talk — in any language, or just talk."
msgstr "همان‌طور که صحبت می‌کنید بنویسید — به هر زبانی، یا فقط صحبت کنید."

msgid "Bangla, English, Banglish — or any language you speak. The app itself comes in 9 languages."
msgstr "بنگالی، انگلیسی، بنگلیش — یا هر زبانی که صحبت می‌کنید. خود برنامه به ۹ زبان موجود است."

msgid "Tell me what you spent or earned — বাংলা, English, Banglish or any language"
msgstr "به من بگویید چه چیزی خرج کردید یا درآمد داشتید — বাংলা، انگلیسی، Banglish یا هر زبان دیگر"

msgid "Currency"
msgstr "واحد پول"

msgid "Used for every amount in the app."
msgstr "برای هر مبلغی در برنامه استفاده می‌شود."

msgid "or"
msgstr "یا"

msgid "Debts"
msgstr "بدهی‌ها"

msgid "Owed to me"
msgstr "طلب من"

msgid "I owe"
msgstr "بدهکارم"

msgid "I borrowed"
msgstr "قرض گرفتم"

msgid "I lent"
msgstr "قرض دادم"

msgid "Money you lent to people or borrowed from them. Lending takes money out of an account and borrowing puts it in, so balances stay right — but it is not counted as income or expense. You can also tell the AI: “rahim ke 500 dhar dilam”, “karim theke 2000 dhar nilam”, “rahim 300 ferot dilo”."
msgstr "پولی که به افراد قرض داده‌اید یا از آن‌ها گرفته‌اید. قرض دادن پول را از حساب کم می‌کند و قرض گرفتن آن را اضافه می‌کند، بنابراین موجودی‌ها درست می‌مانند — اما به عنوان درآمد یا هزینه حساب نمی‌شوند. همچنین می‌توانید به AI بگویید: “rahim ke 500 dhar dilam”, “karim theke 2000 dhar nilam”, “rahim 300 ferot dilo”."

msgid "Active"
msgstr "فعال"

msgid "Closed"
msgstr "بسته شده"

msgid "No closed debts yet. A debt closes by itself when it is fully paid back."
msgstr "هنوز بدهی بسته‌شده‌ای وجود ندارد. وقتی بدهی کاملاً پس داده شود، خودبه‌خود بسته می‌شود."

msgid "No active debts. Nobody owes you and you owe nobody."
msgstr "هیچ بدهی فعالی وجود ندارد. نه کسی به شما بدهکار است و نه شما به کسی بدهکارید."

msgid "Nothing here."
msgstr "اینجا چیزی نیست."

msgid "All debts"
msgstr "همه بدهی‌ها"

msgid "Owes you"
msgstr "به شما بدهکار است"

msgid "You owe"
msgstr "شما بدهکار هستید"

msgid "Paid back"
msgstr "پس داده شد"

msgid "Overdue"
msgstr "معوقه"

msgid "Left to pay back"
msgstr "باقی‌مانده برای پس دادن"

msgid "Pay back by"
msgstr "تاریخ بازپرداخت"

msgid "Record money you got back"
msgstr "ثبت پولی که پس گرفتید"

msgid "Record money you paid back"
msgstr "ثبت پولی که پس دادید"

msgid "“Paid back” adds the money to the account. “Added to debt” is when you lend them more."
msgstr "«پس‌داده‌شده» پول را به حساب اضافه می‌کند. «افزودن به بدهی» زمانی است که پول بیشتری به آن‌ها قرض می‌دهید."

msgid "“Paid back” takes the money out of the account. “Added to debt” is when you borrow more."
msgstr "«پس‌داده‌شده» پول را از حساب خارج می‌کند. «افزودن به بدهی» زمانی است که بیشتر قرض می‌گیرید."

msgid "History"
msgstr "تاریخچه"

msgid "Lent"
msgstr "قرض داده‌شده"

msgid "Borrowed"
msgstr "قرض گرفته‌شده"

msgid "+ is money that came into your account, − is money that left it."
msgstr "+ پولی است که به حساب شما آمده، − پولی است که از آن خارج شده است."

msgid "Reopen debt"
msgstr "باز کردن مجدد بدهی"

msgid "Close this debt without recording a payment? Use this if it was forgiven or settled another way. Balances will not change."
msgstr "این بدهی بدون ثبت پرداخت بسته شود؟ اگر بخشیده شده یا به شکل دیگری تسویه شده از این گزینه استفاده کنید. موجودی‌ها تغییری نخواهند کرد."

msgid "Close without payment"
msgstr "بستن بدون پرداخت"

msgid "%(paid)s of %(total)s paid back"
msgstr "%(paid)s از %(total)s پس داده شد"

msgid "Got paid back"
msgstr "پس گرفته شد"

msgid "I paid back"
msgstr "پس دادم"

msgid "Person"
msgstr "شخص"

msgid "left"
msgstr "باقیمانده"

msgid "Was due %(day)s"
msgstr "سررسید در %(day)s بود"

msgid "Due %(day)s"
msgstr "سررسید %(day)s"

msgid "of %(total)s"
msgstr "از %(total)s"

msgid "Open"
msgstr "باز"

msgid "e.g. Rahim"
msgstr "مثلاً رحیم"

msgid "e.g. for his phone, till salary day"
msgstr "مثلاً برای گوشی‌اش، تا روز حقوق"

msgid "Where the money went out of (lent) or came into (borrowed). Its balance changes."
msgstr "جایی که پول از آن خارج شد (قرض داده شده) یا به آن واریز شد (قرض گرفته شده). موجودی آن تغییر می‌کند."

msgid "Optional."
msgstr "اختیاری."

msgid "The pay-back date can't be before the date of the debt."
msgstr "تاریخ بازپرداخت نمی‌تواند قبل از تاریخ بدهی باشد."

msgid "Only %(left)s is left to pay back."
msgstr "فقط %(left)s برای پس دادن باقی مانده است."

msgid "Added to debt"
msgstr "به بدهی اضافه شد"

msgid "The money left or came into this account."
msgstr "پولی که به این حساب واریز شد یا از آن برداشت شد."

msgid "Lend and borrow"
msgstr "قرض دادن و گرفتن"

msgid "Keep track of money you lent or borrowed. Account balances change, but it is not counted as income or expense."
msgstr "پول‌هایی را که قرض داده‌اید یا گرفته‌اید پیگیری کنید. موجودی حساب‌ها تغییر می‌کند، اما به عنوان درآمد یا هزینه محاسبه نمی‌شود."

msgid "Lent %(amount)s to %(person)s."
msgstr "مبلغ %(amount)s به %(person)s قرض دادید."

msgid "Borrowed %(amount)s from %(person)s."
msgstr "مبلغ %(amount)s از %(person)s قرض گرفتید."

msgid "%(person)s doesn't owe you anything, so the %(amount)s payment was not saved."
msgstr "%(person)s چیزی به شما بدهکار نیست، بنابراین پرداخت %(amount)s ذخیره نشد."

msgid "You don't owe %(person)s anything, so the %(amount)s payment was not saved."
msgstr "شما به %(person)s چیزی بدهکار نیستید، بنابراین پرداخت %(amount)s ذخیره نشد."

msgid "%(person)s paid you back %(amount)s."
msgstr "%(person)s مبلغ %(amount)s را به شما پس داد."

msgid "You paid %(person)s back %(amount)s."
msgstr "شما مبلغ %(amount)s را به %(person)s پس دادید."

msgid "Debt saved."
msgstr "بدهی ذخیره شد."

msgid "Add debt"
msgstr "افزودن بدهی"

msgid "Fully paid back. The debt is closed."
msgstr "کاملاً پس داده شد. بدهی بسته است."

msgid "Saved. %(left)s left."
msgstr "ذخیره شد. %(left)s باقی مانده است."

msgid "Debt updated."
msgstr "بدهی به‌روزرسانی شد."

msgid "Edit debt"
msgstr "ویرایش بدهی"

msgid "Debt deleted. Its payments were removed too."
msgstr "بدهی حذف شد. پرداخت‌های آن نیز حذف شدند."

msgid "Debt closed."
msgstr "بدهی بسته شد."

msgid "Debt reopened."
msgstr "بدهی مجدداً باز شد."

msgid "Payment updated."
msgstr "پرداخت به‌روزرسانی شد."

msgid "Edit payment"
msgstr "ویرایش پرداخت"

msgid "Payment deleted."
msgstr "پرداخت حذف شد."

msgid "Financial Expenses"
msgstr "هزینه‌های مالی"

msgid "Paid back %(person)s"
msgstr "بازپرداخت به %(person)s"

msgid "This expense is a debt repayment. Change it here."
msgstr "این هزینه یک بازپرداخت بدهی است. آن را در اینجا تغییر دهید."

msgid "Keep track of money you lent or borrowed. Account balances change. Paying back money you borrowed counts as an expense (Financial Expenses)."
msgstr "پول‌های قرض‌داده‌شده یا قرض‌گرفته‌شده خود را پیگیری کنید. موجودی حساب‌ها تغییر می‌کند. پس دادن پولی که قرض گرفته بودید، به عنوان هزینه (هزینه‌های مالی) محاسبه می‌شود."

msgid "Money you lent to people or borrowed from them. Lending takes money out of an account and borrowing puts it in, so balances stay right. Paying back money you borrowed counts as an expense (Financial Expenses). You can also tell the AI: “rahim ke 500 dhar dilam”, “karim theke 2000 dhar nilam”, “karim ke 1000 ferot dilam”."
msgstr "پولی که به افراد قرض داده‌اید یا از آن‌ها قرض گرفته‌اید. قرض دادن پول را از حساب خارج می‌کند و قرض گرفتن آن را واریز می‌کند، بنابراین موجودی‌ها درست می‌مانند. پس دادن پولی که قرض گرفته بودید، به عنوان هزینه (هزینه‌های مالی) محسوب می‌شود. همچنین می‌توانید به هوش مصنوعی بگویید: “rahim ke 500 dhar dilam”, “karim theke 2000 dhar nilam”, “karim ke 1000 ferot dilam”."

msgid "“Paid back” takes the money out of the account and counts as an expense (Financial Expenses). “Added to debt” is when you borrow more."
msgstr "گزینه «بازپرداخت» پول را از حساب خارج کرده و به عنوان هزینه (هزینه‌های مالی) در نظر می‌گیرد. «افزودن به بدهی» زمانی است که بیشتر قرض می‌گیرید."

msgid "No matching debts."
msgstr "هیچ بدهی مطابقت‌داشته‌ای یافت نشد."

msgid "This password has appeared in a data breach, so it isn't safe. Please choose a different one."
msgstr "این رمز عبور در یک نشت داده ظاهر شده است، بنابراین امن نیست. لطفاً رمز عبور دیگری انتخاب کنید."

msgid "Your password can't be one that has appeared in a data breach."
msgstr "رمز عبور شما نمی‌تواند همان رمزی باشد که در یک نشت داده ظاهر شده است."

msgid "Use at least 8 characters. It can't be all numbers, too similar to your email, or a common or leaked password."
msgstr "حداقل از ۸ کاراکتر استفاده کنید. نمی‌تواند فقط شامل اعداد باشد، خیلی شبیه به ایمیل شما باشد، یا یک رمز عبور رایج یا لو رفته باشد."

msgid "The AI found %(n)s transaction. Fix anything that looks wrong, then save."
msgid_plural "The AI found %(n)s transactions. Fix anything that looks wrong, then save."
msgstr[0] "AI تعداد %(n)s تراکنش پیدا کرد. هر چیزی که اشتباه به نظر می‌رسد را اصلاح و سپس ذخیره کنید."
msgstr[1] "AI تعداد %(n)s تراکنش پیدا کرد. هر چیزی که اشتباه به نظر می‌رسد را اصلاح و سپس ذخیره کنید."

msgid "%(n)s transaction"
msgid_plural "%(n)s transactions"
msgstr[0] "%(n)s تراکنش"
msgstr[1] "%(n)s تراکنش"

msgid "Saved %(n)s transaction."
msgid_plural "Saved %(n)s transactions."
msgstr[0] "%(n)s تراکنش ذخیره شد."
msgstr[1] "%(n)s تراکنش ذخیره شد."

msgid "This password is too short. It must contain at least %d character."
msgid_plural "This password is too short. It must contain at least %d characters."
msgstr[0] "این رمز عبور خیلی کوتاه است. باید حداقل %d کاراکتر داشته باشد."
msgstr[1] "این رمز عبور خیلی کوتاه است. باید حداقل %d کاراکتر داشته باشد."

msgid "Your password must contain at least %(min_length)d character."
msgid_plural "Your password must contain at least %(min_length)d characters."
msgstr[0] "رمز عبور شما باید حداقل شامل %(min_length)d کاراکتر باشد."
msgstr[1] "رمز عبور شما باید حداقل شامل %(min_length)d کاراکتر باشد."

msgid "%(n)s overdue"
msgid_plural "%(n)s overdue"
msgstr[0] "%(n)s معوقه"
msgstr[1] "%(n)s معوقه"

msgid "%(n)s debt"
msgid_plural "%(n)s debts"
msgstr[0] "بدهی %(n)s"
msgstr[1] "بدهی‌های %(n)s"

msgid "%(n)s debt is past its pay-back date."
msgid_plural "%(n)s debts are past their pay-back date."
msgstr[0] "تاریخ سررسید بدهی %(n)s گذشته است."
msgstr[1] "تاریخ سررسید بدهی‌های %(n)s گذشته است."

msgid "Tell me what you spent or earned, in any language"
msgstr "به من بگویید چه خرج کردید یا چه درآمدی داشتید، به هر زبانی"

msgid "Spent 550 on groceries today, taxi 80, got 6000 from tutoring"
msgstr "امروز 550 خرید خواربار، تاکسی 80، و 6000 از تدریس خصوصی گرفتم"

msgid "Spent 550 on groceries today and 80 on a taxi"
msgstr "امروز 550 برای خواربار و 80 برای تاکسی خرج کردم"

msgid "groceries 550, taxi 80"
msgstr "خواربار 550، تاکسی 80"

msgid "Yesterday lunch 250 and phone top-up 100"
msgstr "دیروز ناهار 250 و شارژ موبایل 100"

msgid "lunch 250, top-up 100"
msgstr "ناهار 250، شارژ 100"

msgid "Got my salary 35000 today and paid rent 12000"
msgstr "امروز حقوقم 35000 را گرفتم و 12000 اجاره دادم"

msgid "salary 35000, rent 12000"
msgstr "حقوق 35000، اجاره 12000"

msgid "Find in the list"
msgstr "در فهرست پیدا کنید"

msgid "Search by name"
msgstr "جستجو با نام"

msgid "Not in the list? Type the name in the box below."
msgstr "در فهرست نیست؟ نام را در کادر زیر بنویسید."
