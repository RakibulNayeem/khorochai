msgstr "Pina-utang ng %(amount)s si %(person)s."

msgid "Borrowed %(amount)s from %(person)s."
msgstr "Umutang ng %(amount)s kay %(person)s."

msgid "%(person)s doesn't owe you anything, so the %(amount)s payment was not saved."
msgstr "Walang utang sa iyo si %(person)s, kaya hindi na-save ang bayad na %(amount)s."

msgid "You don't owe %(person)s anything, so the %(amount)s payment was not saved."
msgstr "Wala kang utang kay %(person)s, kaya hindi nai-save ang bayad na %(amount)s."

msgid "%(person)s paid you back %(amount)s."
msgstr "Nagbayad sa iyo si %(person)s ng %(amount)s."

msgid "You paid %(person)s back %(amount)s."
msgstr "Binayaran mo si %(person)s ng %(amount)s."

