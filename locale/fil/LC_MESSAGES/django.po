msgid_plural "Saved %(n)s transactions."
msgstr[0] "Na-save ang %(n)s na transaksyon."
msgstr[1] "Na-save ang %(n)s na mga transaksyon."

msgid "This password is too short. It must contain at least %d character."
msgid_plural "This password is too short. It must contain at least %d characters."
msgstr[0] "Masyadong maikli ang password. Dapat ay mayroon itong hindi bababa sa %d character."
msgstr[1] "Masyadong maikli ang password. Dapat ay mayroon itong hindi bababa sa %d mga character."

msgid "Your password must contain at least %(min_length)d character."
msgid_plural "Your password must contain at least %(min_length)d characters."
msgstr[0] "Ang iyong password ay dapat maglaman ng hindi bababa sa %(min_length)d karakter."
msgstr[1] "Ang iyong password ay dapat maglaman ng hindi bababa sa %(min_length)d mga karakter."

msgid "%(n)s overdue"
msgid_plural "%(n)s overdue"
msgstr[0] "Lampas sa takdang petsa ang %(n)s"
msgstr[1] "Lampas sa takdang petsa ang %(n)s"

msgid "%(n)s debt"
msgid_plural "%(n)s debts"
msgstr[0] "Utang na %(n)s"
msgstr[1] "Mga utang na %(n)s"

msgid "%(n)s debt is past its pay-back date."
msgid_plural "%(n)s debts are past their pay-back date."
