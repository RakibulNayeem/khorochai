msgstr "پاس ورڈ بھول گئے؟"

msgid "The email address and/or password you specified are not correct."
msgstr "آپ کا دیا ہوا ای میل ایڈریس اور/یا پاس ورڈ درست نہیں ہے۔"

msgid "A user is already registered with this email address."
msgstr "اس ای میل ایڈریس کے ساتھ پہلے ہی ایک صارف رجسٹرڈ ہے۔"

msgid "You must type the same password each time."
msgstr "آپ کو ہر بار ایک ہی پاس ورڈ ٹائپ کرنا ہوگا۔"

msgid "Code"
msgstr "کوڈ"

msgid "Incorrect code."
msgstr "غلط کوڈ۔"

msgid "Email Verification"
msgstr "ای میل کی تصدیق"

msgid "Enter Email Verification Code"
msgstr "ای میل تصدیقی کوڈ درج کریں"

msgid "We've sent a code to %(recipient)s. The code expires shortly, so please enter it soon."
msgstr "ہم نے %(recipient)s پر ایک کوڈ بھیجا ہے۔ کوڈ جلد ختم ہو جائے گا، لہذا براہ کرم اسے جلد درج کریں۔"

msgid "Request new code"
msgstr "نیا کوڈ درکار ہے"

msgid "Use a different email address"
msgstr "کوئی دوسرا ای میل ایڈریس استعمال کریں"

msgid "Confirmation email sent to %(email)s."
msgstr "تصدیقی ای میل %(email)s پر بھیج دی گئی ہے۔"

msgid "Successfully signed in as %(name)s."
msgstr "%(name)s کے طور پر کامیابی سے سائن ان ہو گئے۔"

msgid "You have signed out."
msgstr "آپ سائن آؤٹ ہو چکے ہیں۔"

msgid "You have confirmed %(email)s."
msgstr "آپ نے %(email)s کی تصدیق کر لی ہے۔"

msgid "Password successfully changed."
msgstr "پاس ورڈ کامیابی سے تبدیل ہو گیا۔"

msgid "Password successfully set."
msgstr "پاس ورڈ کامیابی سے سیٹ ہو گیا۔"

msgid "Password Reset"
msgstr "پاس ورڈ ری سیٹ"

msgid "Forgotten your password? Enter your email address below, and we'll send you an email allowing you to reset it."
msgstr "پاس ورڈ بھول گئے؟ اپنا ای میل ایڈریس نیچے درج کریں، اور ہم آپ کو پاس ورڈ ری سیٹ کرنے کے لیے ایک ای میل بھیجیں گے۔"

msgid "Please contact us if you have any trouble resetting your password."
msgstr "اگر آپ کو پاس ورڈ ری سیٹ کرنے میں کوئی مسئلہ ہو تو براہ کرم ہم سے رابطہ کریں۔"

msgid "Reset My Password"
msgstr "میرا پاس ورڈ ری سیٹ کریں"

msgid "Enter Password Reset Code"
msgstr "پاس ورڈ ری سیٹ کوڈ درج کریں"

msgid "Change Password"
msgstr "پاس ورڈ تبدیل کریں"

msgid "Your password is now changed."
msgstr "آپ کا پاس ورڈ اب تبدیل ہو چکا ہے۔"

msgid "New Password"
msgstr "نیا پاس ورڈ"

msgid "Current Password"
msgstr "موجودہ پاس ورڈ"

msgid "Sign Out"
msgstr "سائن آؤٹ"

msgid "Are you sure you want to sign out?"
msgstr "کیا آپ واقعی سائن آؤٹ کرنا چاہتے ہیں؟"

msgid "This password is too common."
msgstr "یہ پاس ورڈ بہت عام ہے۔"

msgid "This password is entirely numeric."
msgstr "یہ پاس ورڈ مکمل طور پر عددی ہے۔"

msgid "The password is too similar to the %(verbose_name)s."
msgstr "پاس ورڈ %(verbose_name)s سے بہت ملتا جلتا ہے۔"

msgid "Your password can’t be too similar to your other personal information."
msgstr "آپ کا پاس ورڈ آپ کی دیگر ذاتی معلومات سے بہت زیادہ ملتا جلتا نہیں ہو سکتا۔"

msgid "Your password can’t be a commonly used password."
msgstr "آپ کا پاس ورڈ عام استعمال ہونے والا پاس ورڈ نہیں ہو سکتا۔"

msgid "Your password can’t be entirely numeric."
msgstr "آپ کا پاس ورڈ مکمل طور پر ہندسوں پر مشتمل نہیں ہو سکتا۔"

msgid "Continue with %(provider)s"
msgstr "%(provider)s کے ساتھ جاری رکھیں"

msgid "or with email"
msgstr "یا ای میل کے ساتھ"

msgid "You'll get ready-made categories and accounts to start with. We'll email you a 6-digit code to confirm your email."
msgstr "شروعات کے لیے آپ کو پہلے سے تیار شدہ کیٹیگریز اور اکاؤنٹس ملیں گے۔ ہم آپ کی ای میل کی تصدیق کے لیے 6 ہندسوں کا کوڈ ای میل کریں گے۔"

msgid "Profile"
msgstr "پروفائل"

msgid "Email (used to log in)"
msgstr "ای میل (لاگ ان کے لیے استعمال ہوتا ہے)"

msgid "Change email"
msgstr "ای میل تبدیل کریں"

msgid "Change password"
msgstr "پاس ورڈ تبدیل کریں"

msgid "Google / Facebook login"
msgstr "Google / Facebook لاگ ان"

msgid "Shown in the app. You log in with your email, not this."
msgstr "ایپ میں دکھایا گیا ہے۔ آپ اپنے ای میل سے لاگ ان ہوتے ہیں، اس سے نہیں۔"

msgid "This username is already taken."
msgstr "یہ یوزر نیم پہلے ہی لیا جا چکا ہے۔"

msgid "Username updated."
msgstr "یوزر نیم اپ ڈیٹ ہو گیا۔"

msgid "Hello from KhorochAi!"
msgstr "KhorochAi کی طرف سے ہیلو!"

msgid "Thank you for using KhorochAi."
msgstr "KhorochAi استعمال کرنے کا شکریہ۔"

msgid "Your email verification code is:"
msgstr "آپ کا ای میل ویریفیکیشن کوڈ ہے:"

msgid "Enter it in the KhorochAi page that is open in your browser. The code expires soon."
msgstr "اسے اپنے براؤزر میں کھلے ہوئے KhorochAi صفحے پر درج کریں۔ کوڈ جلد ختم ہو جائے گا۔"

msgid "To confirm your email, open %(activate_url)s"
msgstr "اپنی ای میل کی تصدیق کے لیے، %(activate_url)s کھولیں"

msgid "If you did not sign up for KhorochAi, you can ignore this email."
msgstr "اگر آپ نے KhorochAi کے لیے سائن اپ نہیں کیا تھا، تو آپ اس ای میل کو نظر انداز کر سکتے ہیں۔"

msgid "Your verification code"
msgstr "آپ کا ویریفیکیشن کوڈ"

msgid "Your password reset code is:"
msgstr "آپ کا پاس ورڈ ری سیٹ کوڈ ہے:"

msgid "If you did not ask to reset your password, you can ignore this email. Your password has not changed."
msgstr "اگر آپ نے پاس ورڈ ری سیٹ کرنے کی درخواست نہیں کی تھی، تو آپ اس ای میل کو نظر انداز کر سکتے ہیں۔ آپ کا پاس ورڈ تبدیل نہیں ہوا ہے۔"

msgid "Your password reset code"
msgstr "آپ کا پاس ورڈ ری سیٹ کوڈ"

msgid "Set balance"
msgstr "بیلنس سیٹ کریں"

msgid "Balance now"
msgstr "موجودہ بیلنس"

msgid "Balance updated: %(list)s."
msgstr "بیلنس اپ ڈیٹ ہو گیا: %(list)s۔"

msgid "Good morning, %(name)s"
msgstr "صبح بخیر، %(name)s"

msgid "Good afternoon, %(name)s"
msgstr "دوپہر بخیر، %(name)s"

msgid "Good evening, %(name)s"
msgstr "شام بخیر، %(name)s"

msgid "Speak instead of typing"
msgstr "ٹائپ کرنے کے بجائے بولیں"

msgid "Stop recording"
msgstr "ریکارڈنگ روکیں"

msgid "Writing what you said…"
msgstr "جو آپ نے کہا اسے لکھ رہے ہیں…"

msgid "Microphone access is blocked. Allow it in your browser settings and try again."
msgstr "مائکروفون تک رسائی بلاک ہے۔ اپنے براؤزر کی سیٹنگز میں اس کی اجازت دیں اور دوبارہ کوشش کریں۔"

msgid "That was too short. Hold on a moment and speak, then tap stop."
msgstr "یہ بہت مختصر تھا۔ ایک لمحہ رکیں اور بولیں، پھر اسٹاپ ٹیپ کریں۔"

msgid "Could not send the recording. Check your connection and try again."
msgstr "ریکارڈنگ نہیں بھیجی جا سکی۔ اپنا کنکشن چیک کریں اور دوبارہ کوشش کریں۔"

msgid "No recording was received."
msgstr "کوئی ریکارڈنگ موصول نہیں ہوئی۔"

msgid "The recording is too long. Please keep it under a minute."
msgstr "ریکارڈنگ بہت لمبی ہے۔ براہ کرم اسے ایک منٹ سے کم رکھیں۔"

msgid "Couldn't turn the recording into text right now. Please try again or type it."
msgstr "فی الحال ریکارڈنگ کو ٹیکسٹ میں تبدیل نہیں کیا جا سکا۔ براہ کرم دوبارہ کوشش کریں یا ٹائپ کریں۔"

msgid "I couldn't hear anything. Please try again a little closer to the mic."
msgstr "مجھے کچھ سنائی نہیں دیا۔ براہ کرم مائک کے تھوڑا قریب ہو کر دوبارہ کوشش کریں۔"

msgid "Set budget"
msgstr "بجٹ سیٹ کریں"

msgid "Monthly budget set: %(list)s."
msgstr "ماہانہ بجٹ سیٹ کیا گیا: %(list)s۔"

msgid "%(name)s (removed)"
msgstr "%(name)s (ہٹا دیا گیا)"

msgid "Help & contact"
msgstr "مدد اور رابطہ"

msgid "Everything works by typing or speaking in plain English, বাংলা or Banglish. You always see a preview before anything is saved."
msgstr "سب کچھ سادہ انگریزی، বাংলা یا Banglish میں ٹائپ یا بول کر کام کرتا ہے۔ کچھ بھی محفوظ ہونے سے پہلے آپ ہمیشہ ایک پیش نظارہ دیکھتے ہیں۔"

msgid "How to use KhorochAi"
msgstr "KhorochAi کا استعمال کیسے کریں"

msgid "Good to know"
msgstr "جاننا اچھا ہے"

msgid "The AI only reads your text; every total and balance is calculated by the app from your saved data."
msgstr "AI صرف آپ کا ٹیکسٹ پڑھتا ہے؛ ہر ٹوٹل اور بیلنس ایپ آپ کے محفوظ کردہ ڈیٹا سے حساب کرتی ہے۔"

msgid "AI use has a daily allowance, shown on the dashboard. It resets at midnight, and you can always add things manually."
msgstr "AI کے استعمال کی یومیہ حد ہے، جو ڈیش بورڈ پر دکھائی جاتی ہے۔ یہ آدھی رات کو ری سیٹ ہو جاتی ہے، اور آپ ہمیشہ چیزیں خود درج کر سکتے ہیں۔"

msgid "Never type card numbers or passwords."
msgstr "کبھی بھی کارڈ نمبر یا پاس ورڈ ٹائپ نہ کریں۔"

msgid "Change the theme, language and your username from the menu at the top right."
msgstr "اوپر دائیں جانب مینو سے تھیم، زبان اور اپنا صارف نام تبدیل کریں۔"

msgid "Contact"
msgstr "رابطہ"

msgid "Questions, problems or ideas"
msgstr "سوالات، مسائل یا آئیڈیاز"

msgid "Write to us and we'll get back to you."
msgstr "ہمیں لکھیں اور ہم آپ سے رابطہ کریں گے۔"

msgid "Developer"
msgstr "ڈویلپر"

msgid "KhorochAi is built by %(name)s."
msgstr "KhorochAi کو %(name)s نے بنایا ہے۔"

msgid "Account menu"
msgstr "اکاؤنٹ مینو"

msgid "First name"
msgstr "پہلا نام"

msgid "Shown in the greeting and the menu."
msgstr "خیرمقدمی پیغام اور مینو میں دکھایا گیا ہے۔"

msgid "Profile updated."
msgstr "پروفائل اپ ڈیٹ ہو گئی۔"

msgid "Add spending or income"
msgstr "اخراجات یا آمدنی شامل کریں"

msgid "Type what happened in the box on the dashboard and press Add with AI."
msgstr "ڈیش بورڈ پر موجود باکس میں لکھیں کہ کیا ہوا اور Add with AI دبائیں۔"

msgid "Tap the mic in the box, talk, then tap stop. Check the text, then press Add with AI."
msgstr "باکس میں مائک کو ٹیپ کریں، بات کریں، پھر اسٹاپ دبائیں۔ ٹیکسٹ چیک کریں، پھر AI کے ساتھ شامل کریں دبائیں۔"

msgid "Accounts and moving money"
msgstr "اکاؤنٹس اور رقم کی منتقلی"

msgid "Say which account you used, or move money between your own accounts."
msgstr "بتائیں کہ آپ نے کون سا اکاؤنٹ استعمال کیا، یا اپنے اکاؤنٹس کے درمیان رقم منتقل کریں۔"

msgid "Set an account balance"
msgstr "اکاؤنٹ بیلنس سیٹ کریں"

msgid "Tell the AI how much is in an account right now."
msgstr "AI کو بتائیں کہ ابھی اکاؤنٹ میں کتنی رقم ہے۔"

msgid "Monthly budgets"
msgstr "ماہانہ بجٹ"

msgid "Set a spending limit for a category and watch the progress bar on the dashboard."
msgstr "کسی زمرے کے لیے خرچ کی حد مقرر کریں اور ڈیش بورڈ پر پروگریس بار دیکھیں۔"

msgid "Ask about your money"
msgstr "اپنی رقم کے بارے میں پوچھیں"

msgid "Use Ask AI for totals, breakdowns and comparisons."
msgstr "کل، تفصیلات اور موازنہ کے لیے Ask AI کا استعمال کریں۔"

msgid "Portfolio"
msgstr "پورٹ فولیو"

msgid "Help"
msgstr "مدد"

msgid "About & contact"
msgstr "ہمارے بارے میں اور رابطہ"

msgid "Made by"
msgstr "بنایا گیا از"

msgid "Developer, KhorochAi"
msgstr "ڈویلپر، KhorochAi"

msgid "How can we help?"
msgstr "ہم آپ کی کیا مدد کر سکتے ہیں؟"

msgid "Still need help?"
msgstr "اب بھی مدد چاہیے؟"

msgid "Write to us — questions, problems and ideas are all welcome."
msgstr "ہمیں لکھیں — سوالات، مسائل اور آئیڈیاز سب خوش آئند ہیں۔"

msgid "Contact us"
msgstr "ہم سے رابطہ کریں"

msgid "Money tracking that speaks your language"
msgstr "ایسا منی ٹریکنگ جو آپ کی زبان سمجھتا ہے"

msgid "KhorochAi lets you track spending and income just by typing or speaking — in English, বাংলা or Banglish. The AI understands what you mean; the app does all the maths."
msgstr "KhorochAi آپ کو English, বাংলা یا Banglish میں ٹائپ کر کے یا بول کر اخراجات اور آمدنی کو ٹریک کرنے کی سہولت دیتا ہے۔ AI سمجھتا ہے کہ آپ کا کیا مطلب ہے؛ ایپ تمام حساب کتاب خود کر لیتی ہے۔"

msgid "Type or talk"
msgstr "ٹائپ کریں یا بات کریں"

msgid "No forms to fill. Say “aaj lunch 250 bkash e” and it's recorded."
msgstr "کوئی فارم بھرنے کی ضرورت نہیں۔ بس کہیں “aaj lunch 250 bkash e” اور یہ ریکارڈ ہو جائے گا۔"

msgid "See where it goes"
msgstr "دیکھیں کہ خرچ کہاں ہو رہا ہے"

msgid "Accounts, budgets and charts show your money at a glance, and Ask AI answers your questions."
msgstr "اکاؤنٹس، بجٹ اور چارٹس آپ کی رقم کا ایک نظر میں جائزہ پیش کرتے ہیں، اور Ask AI آپ کے سوالات کے جواب دیتا ہے۔"

msgid "Correct by design"
msgstr "ڈیزائن کے لحاظ سے درست"

msgid "You check every entry before it's saved, and totals are always calculated from your own data."
msgstr "آپ ہر اندراج کو محفوظ ہونے سے پہلے چیک کرتے ہیں، اور کل ہمیشہ آپ کے اپنے ڈیٹا سے شمار کیا جاتا ہے۔"

msgid "Questions, problems or ideas — write to us and we'll get back to you."
msgstr "سوالات، مسائل یا آئیڈیاز — ہمیں لکھیں اور ہم آپ سے رابطہ کریں گے۔"

msgid "Read the help guide"
msgstr "مددگار گائیڈ پڑھیں"

msgid "KhorochAi — Expense & income tracker you can talk to"
msgstr "KhorochAi — اخراجات اور آمدنی کا ٹریکر جس سے آپ بات کر سکتے ہیں"

msgid "Just say it. Your hisab is done."
msgstr "بس بول دیں۔ آپ کا حساب ہو گیا۔"

msgid "Just say it. Your hisab is done. Track spending and income by typing or speaking in English, বাংলা or Banglish."
msgstr "بس بول دیں۔ آپ کا حساب ہو گیا۔ English, বাংলা یا Banglish میں ٹائپ کر کے یا بول کر اخراجات اور آمدنی کو ٹریک کریں۔"

msgid "Free · English, বাংলা & Banglish"
msgstr "مفت · English, বাংলা & Banglish"

msgid "Type or speak what you spent or earned — like you'd tell a friend. KhorochAi turns it into neat entries, keeps your accounts and budgets up to date, and answers your money questions."
msgstr "جو آپ نے خرچ کیا یا کمایا اسے ٹائپ کریں یا بولیں — جیسے آپ کسی دوست کو بتاتے ہیں۔ KhorochAi اسے درست اندراجات میں بدل دیتا ہے، آپ کے اکاؤنٹس اور بجٹ کو اپ ٹو ڈیٹ رکھتا ہے، اور آپ کے پیسوں سے متعلق سوالات کے جواب دیتا ہے۔"

msgid "Create free account"
msgstr "مفت اکاؤنٹ بنائیں"

msgid "Sign up with your email. You check every entry before it's saved."
msgstr "اپنے ای میل کے ساتھ سائن اپ کریں۔ محفوظ ہونے سے پہلے آپ ہر اندراج کو چیک کرتے ہیں۔"

msgid "Write it the way you talk"
msgstr "اسے اس طرح لکھیں جیسے آپ بات کرتے ہیں"

msgid "One message can hold several entries — spending, income, transfers between your accounts, even budgets. The AI reads it; you check the preview and save."
msgstr "ایک پیغام میں کئی اندراجات ہو سکتے ہیں — اخراجات، آمدنی، اکاؤنٹس کے درمیان منتقلی، یہاں تک کہ بجٹ بھی۔ AI اسے پڑھتا ہے؛ آپ پریویو چیک کریں اور محفوظ کریں۔"

msgid "How it works"
msgstr "یہ کیسے کام کرتا ہے"

msgid "Type or say it"
msgstr "ٹائپ کریں یا بولیں"

msgid "Write or speak what happened, in English, বাংলা or Banglish. Several things in one message is fine."
msgstr "جو ہوا اسے لکھیں یا بولیں، انگریزی، বাংলা یا Banglish میں۔ ایک پیغام میں کئی چیزیں ٹھیک ہیں۔"

msgid "Check the preview"
msgstr "پیش نظارہ (preview) چیک کریں"

msgid "See exactly what the AI understood — amount, category, account and date. Fix anything with a tap."
msgstr "دیکھیں کہ AI نے کیا سمجھا — رقم، زمرہ، اکاؤنٹ اور تاریخ۔ کسی بھی چیز کو ٹیپ کر کے درست کریں۔"

msgid "Saved and up to date"
msgstr "محفوظ اور اپ ٹو ڈیٹ"

msgid "Your totals, account balances, budgets and charts update instantly."
msgstr "آپ کے ٹوٹلز، اکاؤنٹ بیلنس، بجٹ اور چارٹس فوری طور پر اپ ڈیٹ ہو جاتے ہیں۔"

msgid "Everything you need, nothing you don't"
msgstr "ہر وہ چیز جس کی آپ کو ضرورت ہے، کوئی غیر ضروری چیز نہیں"

msgid "Voice input"
msgstr "وائس ان پٹ"

msgid "Tap the mic and speak. Your words appear in the box for you to check."
msgstr "مائک کو ٹیپ کریں اور بولیں۔ آپ کے الفاظ چیک کرنے کے لیے باکس میں ظاہر ہوں گے۔"

msgid "Your language"
msgstr "آپ کی زبان"

msgid "English, বাংলা or Banglish — and the whole app can switch to Bangla."
msgstr "انگریزی، বাংলা یا Banglish — اور پوری ایپ کو বাংলা میں تبدیل کیا جا سکتا ہے۔"

msgid "All your accounts"
msgstr "آپ کے تمام اکاؤنٹس"

msgid "Cash, bKash, Nagad, Rocket, bank and card, with transfers between them."
msgstr "کیش، bKash، Nagad، Rocket، بینک اور کارڈ، ان کے درمیان رقم کی منتقلی کے ساتھ۔"

msgid "Set limits per category and watch the progress bars as you spend."
msgstr "ہر زمرے کے لیے حد مقرر کریں اور خرچ کرتے وقت پروگریس بار دیکھیں۔"

msgid "“এই মাসে খাবারে কত খরচ হলো?” — get the answer from your own data."
msgstr "“এই মাসে খাবারে কত খরচ হলো?” — اپنے ڈیٹا سے جواب حاصل کریں۔"

msgid "Clear dashboard"
msgstr "ڈیش بورڈ صاف کریں"

msgid "Income, expense, balance, where your money went and day-by-day charts."
msgstr "آمدنی، اخراجات، بیلنس، آپ کا پیسہ کہاں خرچ ہوا اور روزانہ کے چارٹس۔"

msgid "Light and dark"
msgstr "لائٹ اور ڈارک"

msgid "A calm design that follows your phone's dark mode, or pick your own."
msgstr "ایک پرسکون ڈیزائن جو آپ کے فون کے ڈارک موڈ کے مطابق ڈھل جاتا ہے، یا اپنا انتخاب کریں۔"

msgid "Export to CSV"
msgstr "CSV میں ایکسپورٹ کریں"

msgid "Download your transactions for Excel or Google Sheets any time."
msgstr "اپنے لین دین (transactions) کو کسی بھی وقت Excel یا Google Sheets کے لیے ڈاؤن لوڈ کریں۔"

msgid "Start your hisab in a minute"
msgstr "اپنا حساب ایک منٹ میں شروع کریں"

msgid "Create a free account with your email, then just tell KhorochAi what you spent today."
msgstr "اپنے ای میل کے ساتھ مفت اکاؤنٹ بنائیں، پھر بس KhorochAi کو بتائیں کہ آپ نے آج کیا خرچ کیا۔"

msgid "See how it works"
msgstr "دیکھیں یہ کیسے کام کرتا ہے"

msgid "Free to use"
msgstr "استعمال کے لیے مفت"

msgid "You confirm every entry"
msgstr "آپ ہر اندراج کی تصدیق کرتے ہیں"

msgid "Works on phone and computer"
msgstr "فون اور کمپیوٹر پر کام کرتا ہے"

msgid "Write it the way you talk — or just talk."
msgstr "اسے اس طرح لکھیں جیسے آپ بات کرتے ہیں — یا صرف بولیں۔"

msgid "Type it, or tap the mic and say it. One message can hold several entries — spending, income, transfers between your accounts, even budgets. You check the preview and save."
msgstr "ٹائپ کریں، یا مائک پر ٹیپ کر کے بولیں۔ ایک پیغام میں کئی اندراجات ہو سکتے ہیں — اخراجات، آمدنی، اکاؤنٹس کے درمیان منتقلی، یہاں تک کہ بجٹ بھی۔ آپ پیش نظارہ (preview) چیک کریں اور محفوظ کریں۔"

msgid "Free · বাংলা, English, Banglish & any language"
msgstr "مفت · বাংলা, English, Banglish & any language"

msgid "Write it the way you talk — in any language, or just talk."
msgstr "اسے اس طرح لکھیں جیسے آپ بات کرتے ہیں — کسی بھی زبان میں، یا صرف بولیں۔"

msgid "Bangla, English, Banglish — or any language you speak. The app itself comes in 9 languages."
msgstr "بنگلہ، انگریزی، Banglish — یا کوئی بھی زبان جو آپ بولتے ہیں۔ ایپ خود 9 زبانوں میں دستیاب ہے۔"

msgid "Tell me what you spent or earned — বাংলা, English, Banglish or any language"
msgstr "مجھے بتائیں کہ آپ نے کیا خرچ کیا یا کمایا — বাংলা، English، Banglish یا کوئی بھی زبان"

msgid "Currency"
msgstr "کرنسی"

msgid "Used for every amount in the app."
msgstr "ایپ میں ہر رقم کے لیے استعمال ہوتا ہے۔"

msgid "or"
msgstr "یا"

msgid "Debts"
msgstr "قرضے"

msgid "Owed to me"
msgstr "مجھ کو ملنا ہے"

msgid "I owe"
msgstr "مجھ پر قرض ہے"

msgid "I borrowed"
msgstr "میں نے قرض لیا"

msgid "I lent"
msgstr "میں نے قرض دیا"

msgid "Money you lent to people or borrowed from them. Lending takes money out of an account and borrowing puts it in, so balances stay right — but it is not counted as income or expense. You can also tell the AI: “rahim ke 500 dhar dilam”, “karim theke 2000 dhar nilam”, “rahim 300 ferot dilo”."
msgstr "وہ رقم جو آپ نے لوگوں کو دی یا ان سے قرض لی۔ قرض دینے سے اکاؤنٹ سے رقم نکلتی ہے اور لینے سے اس میں آتی ہے، لہذا بیلنس درست رہتا ہے — لیکن اسے آمدنی یا خرچ کے طور پر شمار نہیں کیا جاتا۔ آپ AI کو یہ بھی بتا سکتے ہیں: “rahim ke 500 dhar dilam”, “karim theke 2000 dhar nilam”, “rahim 300 ferot dilo”۔"

msgid "Active"
msgstr "فعال"

msgid "Closed"
msgstr "بند"

msgid "No closed debts yet. A debt closes by itself when it is fully paid back."
msgstr "ابھی تک کوئی بند قرض نہیں ہے۔ جب قرض مکمل طور پر واپس کر دیا جاتا ہے تو یہ خود بخود بند ہو جاتا ہے۔"

msgid "No active debts. Nobody owes you and you owe nobody."
msgstr "کوئی فعال قرض نہیں ہے۔ نہ کسی پر آپ کا قرض ہے اور نہ آپ پر کسی کا۔"

msgid "Nothing here."
msgstr "یہاں کچھ نہیں ہے۔"

msgid "All debts"
msgstr "تمام قرضے"

msgid "Owes you"
msgstr "آپ کے ذمے واجب الادا ہے"

msgid "You owe"
msgstr "آپ نے دینا ہے"

msgid "Paid back"
msgstr "واپس ادا کر دیا گیا"

msgid "Overdue"
msgstr "معیاد ختم"

msgid "Left to pay back"
msgstr "واپس ادا کرنے کے لیے باقی"

msgid "Pay back by"
msgstr "تک واپس ادا کریں"

msgid "Record money you got back"
msgstr "واپس ملی ہوئی رقم درج کریں"

msgid "Record money you paid back"
msgstr "واپس ادا کی گئی رقم درج کریں"

msgid "“Paid back” adds the money to the account. “Added to debt” is when you lend them more."
msgstr "\"واپس ادا کیا\" سے رقم اکاؤنٹ میں شامل ہو جاتی ہے۔ \"قرض میں اضافہ\" اس وقت ہوتا ہے جب آپ انہیں مزید قرض دیتے ہیں۔"

msgid "“Paid back” takes the money out of the account. “Added to debt” is when you borrow more."
msgstr "\"واپس ادا کیا\" سے رقم اکاؤنٹ سے نکل جاتی ہے۔ \"قرض میں اضافہ\" اس وقت ہوتا ہے جب آپ مزید قرض لیتے ہیں۔"

msgid "History"
msgstr "تاریخچہ"

msgid "Lent"
msgstr "قرض دیا"

msgid "Borrowed"
msgstr "قرض لیا"

msgid "+ is money that came into your account, − is money that left it."
msgstr "+ وہ رقم ہے جو آپ کے اکاؤنٹ میں آئی، − وہ رقم ہے جو اس سے نکلی۔"

msgid "Reopen debt"
msgstr "قرض دوبارہ کھولیں"

msgid "Close this debt without recording a payment? Use this if it was forgiven or settled another way. Balances will not change."
msgstr "ادائیگی درج کیے بغیر اس قرض کو بند کریں؟ اگر اسے معاف کر دیا گیا ہے یا کسی اور طریقے سے طے کیا گیا ہے تو اسے استعمال کریں۔ بیلنس تبدیل نہیں ہوں گے۔"

msgid "Close without payment"
msgstr "بغیر ادائیگی کے بند کریں"

msgid "%(paid)s of %(total)s paid back"
msgstr "%(total)s میں سے %(paid)s واپس ادا کر دیے گئے"

msgid "Got paid back"
msgstr "رقم واپس مل گئی"

msgid "I paid back"
msgstr "میں نے واپس ادا کر دیا"

msgid "Person"
msgstr "شخص"

msgid "left"
msgstr "باقی"

msgid "Was due %(day)s"
msgstr "مقررہ تاریخ %(day)s تھی"

msgid "Due %(day)s"
msgstr "%(day)s تک واجب الادا"

msgid "of %(total)s"
msgstr "کل %(total)s میں سے"

msgid "Open"
msgstr "کھولیں"

msgid "e.g. Rahim"
msgstr "مثلاً رحیم"

msgid "e.g. for his phone, till salary day"
msgstr "مثلاً اس کے فون کے لیے، تنخواہ کے دن تک"

msgid "Where the money went out of (lent) or came into (borrowed). Its balance changes."
msgstr "جہاں سے رقم نکلی (قرض دیا) یا آئی (قرض لیا)۔ اس کا بیلنس تبدیل ہوتا ہے۔"

msgid "Optional."
msgstr "اختیاری۔"

msgid "The pay-back date can't be before the date of the debt."
msgstr "واپس کرنے کی تاریخ قرض کی تاریخ سے پہلے کی نہیں ہو سکتی۔"

msgid "Only %(left)s is left to pay back."
msgstr "صرف %(left)s واپس ادا کرنے باقی ہیں۔"

msgid "Added to debt"
msgstr "قرض میں شامل کر دیا گیا"

msgid "The money left or came into this account."
msgstr "وہ رقم جو اس اکاؤنٹ میں آئی یا اس سے نکلی۔"

msgid "Lend and borrow"
msgstr "قرض دینا اور لینا"

msgid "Keep track of money you lent or borrowed. Account balances change, but it is not counted as income or expense."
msgstr "اپنے دیے یا لیے گئے قرض کا حساب رکھیں۔ اکاؤنٹ کا بیلنس تبدیل ہوتا ہے، لیکن اسے آمدنی یا خرچ کے طور پر شمار نہیں کیا جاتا۔"

msgid "Lent %(amount)s to %(person)s."
msgstr "%(person)s کو %(amount)s قرض دیے۔"

msgid "Borrowed %(amount)s from %(person)s."
msgstr "%(person)s سے %(amount)s قرض لیے۔"

msgid "%(person)s doesn't owe you anything, so the %(amount)s payment was not saved."
msgstr "%(person)s پر آپ کا کوئی بقایا نہیں ہے، اس لیے %(amount)s کی ادائیگی محفوظ نہیں کی گئی۔"

msgid "You don't owe %(person)s anything, so the %(amount)s payment was not saved."
msgstr "آپ نے %(person)s کو کچھ ادھار نہیں دینا، اس لیے %(amount)s کی ادائیگی محفوظ نہیں ہوئی۔"

msgid "%(person)s paid you back %(amount)s."
msgstr "%(person)s نے آپ کو %(amount)s واپس کر دیے۔"

msgid "You paid %(person)s back %(amount)s."
msgstr "آپ نے %(person)s کو %(amount)s واپس کر دیے ہیں۔"

msgid "Debt saved."
msgstr "قرض محفوظ ہو گیا۔"

msgid "Add debt"
msgstr "قرض شامل کریں"

msgid "Fully paid back. The debt is closed."
msgstr "مکمل طور پر واپس ادا کر دیا گیا۔ قرض بند ہے۔"

msgid "Saved. %(left)s left."
msgstr "محفوظ ہو گیا۔ %(left)s باقی ہیں۔"

msgid "Debt updated."
msgstr "قرض اپ ڈیٹ ہو گیا۔"

msgid "Edit debt"
msgstr "قرض میں ترمیم کریں"

msgid "Debt deleted. Its payments were removed too."
msgstr "قرض حذف کر دیا گیا۔ اس کی ادائگییاں بھی ہٹا دی گئیں۔"

msgid "Debt closed."
msgstr "قرض بند کر دیا گیا۔"

msgid "Debt reopened."
msgstr "قرض دوبارہ کھول دیا گیا۔"

msgid "Payment updated."
msgstr "ادائیگی اپ ڈیٹ کر دی گئی۔"

msgid "Edit payment"
msgstr "ادائیگی میں ترمیم کریں"

msgid "Payment deleted."
msgstr "ادائیگی حذف کر دی گئی۔"

msgid "Financial Expenses"
msgstr "مالی اخراجات"

msgid "Paid back %(person)s"
msgstr "%(person)s کو واپس کر دیے"

msgid "This expense is a debt repayment. Change it here."
msgstr "یہ خرچہ قرض کی ادائیگی ہے۔ اسے یہاں تبدیل کریں۔"

msgid "Keep track of money you lent or borrowed. Account balances change. Paying back money you borrowed counts as an expense (Financial Expenses)."
msgstr "اپنے ادھار دیے یا لیے گئے پیسوں کا حساب رکھیں۔ اکاؤنٹ کا بیلنس بدل جاتا ہے۔ ادھار لیے ہوئے پیسے واپس کرنا ایک خرچہ (مالی اخراجات) مانا جاتا ہے۔"

msgid "Money you lent to people or borrowed from them. Lending takes money out of an account and borrowing puts it in, so balances stay right. Paying back money you borrowed counts as an expense (Financial Expenses). You can also tell the AI: “rahim ke 500 dhar dilam”, “karim theke 2000 dhar nilam”, “karim ke 1000 ferot dilam”."
msgstr "وہ رقم جو آپ نے لوگوں کو ادھار دی یا ان سے لی۔ ادھار دینے سے اکاؤنٹ سے پیسے نکلتے ہیں اور ادھار لینے سے جمع ہوتے ہیں، اس لیے بیلنس درست رہتا ہے۔ ادھار لیے ہوئے پیسے واپس کرنا ایک خرچہ (مالی اخراجات) مانا جاتا ہے۔ آپ AI کو یہ بھی بتا سکتے ہیں: “rahim ke 500 dhar dilam”, “karim theke 2000 dhar nilam”, “karim ke 1000 ferot dilam”۔"

msgid "“Paid back” takes the money out of the account and counts as an expense (Financial Expenses). “Added to debt” is when you borrow more."
msgstr "“Paid back” سے اکاؤنٹ سے پیسے نکل جاتے ہیں اور یہ ایک خرچہ (مالی اخراجات) شمار ہوتا ہے۔ “Added to debt” وہ ہے جب آپ مزید قرض لیں۔"

msgid "No matching debts."
msgstr "کوئی مطابقت رکھنے والا قرض نہیں ملا۔"

msgid "This password has appeared in a data breach, so it isn't safe. Please choose a different one."
msgstr "یہ پاس ورڈ ڈیٹا لیک میں ظاہر ہو چکا ہے، اس لیے یہ محفوظ نہیں۔ براہ کرم کوئی دوسرا پاس ورڈ منتخب کریں۔"

msgid "Your password can't be one that has appeared in a data breach."
msgstr "آپ کا پاس ورڈ وہ نہیں ہونا چاہیے جو کسی ڈیٹا لیک میں ظاہر ہو چکا ہو۔"

msgid "Use at least 8 characters. It can't be all numbers, too similar to your email, or a common or leaked password."
msgstr "کم از کم 8 حروف استعمال کریں۔ یہ تمام نمبر نہیں ہو سکتے، آپ کے ای میل سے بہت زیادہ ملتے جلتے نہیں ہو سکتے، اور نہ ہی کوئی عام یا لیک شدہ پاس ورڈ ہو سکتا ہے۔"

msgid "The AI found %(n)s transaction. Fix anything that looks wrong, then save."
msgid_plural "The AI found %(n)s transactions. Fix anything that looks wrong, then save."
msgstr[0] "AI نے %(n)s ٹرانزیکشن تلاش کی۔ جو غلط لگے اسے درست کریں، پھر محفوظ کریں۔"
msgstr[1] "AI نے %(n)s ٹرانزیکشنز تلاش کیں۔ جو غلط لگے اسے درست کریں، پھر محفوظ کریں۔"

msgid "%(n)s transaction"
msgid_plural "%(n)s transactions"
msgstr[0] "%(n)s ٹرانزیکشن"
msgstr[1] "%(n)s ٹرانزیکشنز"

msgid "Saved %(n)s transaction."
msgid_plural "Saved %(n)s transactions."
msgstr[0] "%(n)s ٹرانزیکشن محفوظ کر لی گئی۔"
msgstr[1] "%(n)s ٹرانزیکشنز محفوظ کر لی گئیں۔"

msgid "This password is too short. It must contain at least %d character."
msgid_plural "This password is too short. It must contain at least %d characters."
msgstr[0] "یہ پاس ورڈ بہت چھوٹا ہے۔ اس میں کم از کم %d حرف ہونا چاہیے۔"
msgstr[1] "یہ پاس ورڈ بہت چھوٹا ہے۔ اس میں کم از کم %d حروف ہونے چاہئیں۔"

msgid "Your password must contain at least %(min_length)d character."
msgid_plural "Your password must contain at least %(min_length)d characters."
msgstr[0] "آپ کے پاس ورڈ میں کم از کم %(min_length)d کریکٹر ہونا چاہیے۔"
msgstr[1] "آپ کے پاس ورڈ میں کم از کم %(min_length)d کریکٹرز ہونے چاہئیں۔"

msgid "%(n)s overdue"
msgid_plural "%(n)s overdue"
msgstr[0] "%(n)s کی مدت ختم ہو چکی ہے"
msgstr[1] "%(n)s کی مدت ختم ہو چکی ہے"

msgid "%(n)s debt"
msgid_plural "%(n)s debts"
msgstr[0] "%(n)s کا قرض"
msgstr[1] "%(n)s کے قرضے"

msgid "%(n)s debt is past its pay-back date."
msgid_plural "%(n)s debts are past their pay-back date."
msgstr[0] "%(n)s کا قرض واپسی کی تاریخ گزر چکا ہے۔"
msgstr[1] "%(n)s کے قرضے واپسی کی تاریخ گزر چکے ہیں۔"
