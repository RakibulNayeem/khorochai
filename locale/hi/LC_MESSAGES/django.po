msgstr "आपने आज का 100% AI कोटा इस्तेमाल कर लिया है। यह आधी रात को रीसेट हो जाएगा। आप अभी भी मैन्युअल रूप से ट्रांजेक्शन जोड़ सकते हैं।"

msgid "Email"
msgstr "ईमेल"

msgid "Password (again)"
msgstr "पासवर्ड (दोबारा)"

msgid "Forgot your password?"
msgstr "पासवर्ड भूल गए?"

msgid "The email address and/or password you specified are not correct."
msgstr "आपके द्वारा निर्दिष्ट ईमेल पता और/या पासवर्ड सही नहीं है।"

msgid "A user is already registered with this email address."
msgstr "इस ईमेल पते के साथ एक उपयोगकर्ता पहले से पंजीकृत है।"

msgid "You must type the same password each time."
msgstr "आपको हर बार एक ही पासवर्ड टाइप करना होगा।"

msgid "Code"
msgstr "कोड"

msgid "Incorrect code."
msgstr "गलत कोड।"

msgid "Email Verification"
msgstr "ईमेल सत्यापन"

msgid "Enter Email Verification Code"
msgstr "ईमेल सत्यापन कोड दर्ज करें"

msgid "We've sent a code to %(recipient)s. The code expires shortly, so please enter it soon."
msgstr "हमने %(recipient)s पर एक कोड भेजा है। कोड जल्द ही एक्सपायर हो जाएगा, इसलिए कृपया इसे जल्दी दर्ज करें।"

msgid "Request new code"
msgstr "नया कोड अनुरोध करें"

msgid "Use a different email address"
msgstr "दूसरा ईमेल पता इस्तेमाल करें"

msgid "Confirmation email sent to %(email)s."
msgstr "पुष्टिकरण ईमेल %(email)s पर भेजा गया।"

msgid "Successfully signed in as %(name)s."
msgstr "%(name)s के रूप में सफलतापूर्वक साइन इन किया गया।"

msgid "You have signed out."
msgstr "आप साइन आउट हो गए हैं।"

msgid "You have confirmed %(email)s."
msgstr "आपने %(email)s को कन्फर्म कर लिया है।"

msgid "Password successfully changed."
msgstr "पासवर्ड सफलतापूर्वक बदल दिया गया है।"

msgid "Password successfully set."
msgstr "पासवर्ड सफलतापूर्वक सेट हो गया है।"

msgid "Password Reset"
msgstr "पासवर्ड रीसेट"

msgid "Forgotten your password? Enter your email address below, and we'll send you an email allowing you to reset it."
msgstr "पासवर्ड भूल गए? अपना ईमेल पता नीचे दर्ज करें, और हम आपको पासवर्ड रीसेट करने के लिए एक ईमेल भेजेंगे।"

msgid "Please contact us if you have any trouble resetting your password."
msgstr "यदि आपको अपना पासवर्ड रीसेट करने में कोई समस्या हो, तो कृपया हमसे संपर्क करें।"

msgid "Reset My Password"
msgstr "मेरा पासवर्ड रीसेट करें"

msgid "Enter Password Reset Code"
msgstr "पासवर्ड रीसेट कोड दर्ज करें"

msgid "Change Password"
msgstr "पासवर्ड बदलें"

msgid "Your password is now changed."
msgstr "आपका पासवर्ड बदल दिया गया है।"

msgid "New Password"
msgstr "नया पासवर्ड"

msgid "Current Password"
msgstr "वर्तमान पासवर्ड"

msgid "Sign Out"
msgstr "साइन आउट"

msgid "Are you sure you want to sign out?"
msgstr "क्या आप वाकई साइन आउट करना चाहते हैं?"

msgid "This password is too common."
msgstr "यह पासवर्ड बहुत सामान्य है।"

msgid "This password is entirely numeric."
msgstr "यह पासवर्ड पूरी तरह से अंकों वाला है।"

msgid "The password is too similar to the %(verbose_name)s."
msgstr "पासवर्ड %(verbose_name)s से बहुत मिलता-जुलता है।"

msgid "Your password can’t be too similar to your other personal information."
msgstr "आपका पासवर्ड आपकी अन्य व्यक्तिगत जानकारी से बहुत मिलता-जुलता नहीं हो सकता।"

msgid "Your password can’t be a commonly used password."
msgstr "आपका पासवर्ड सामान्य रूप से इस्तेमाल होने वाला पासवर्ड नहीं हो सकता।"

msgid "Your password can’t be entirely numeric."
msgstr "आपका पासवर्ड पूरी तरह से अंकों वाला नहीं हो सकता।"

msgid "Continue with %(provider)s"
msgstr "%(provider)s के साथ जारी रखें"

msgid "or with email"
msgstr "या ईमेल के साथ"

msgid "You'll get ready-made categories and accounts to start with. We'll email you a 6-digit code to confirm your email."
msgstr "शुरुआत करने के लिए आपको पहले से बने कैटेगरी और अकाउंट मिलेंगे। ईमेल कन्फर्म करने के लिए हम आपको 6-अंकों का कोड ईमेल करेंगे।"

msgid "Profile"
msgstr "प्रोफ़ाइल"

msgid "Email (used to log in)"
msgstr "ईमेल (लॉग इन करने के लिए उपयोग किया जाता है)"

msgid "Change email"
msgstr "ईमेल बदलें"

msgid "Change password"
msgstr "पासवर्ड बदलें"

msgid "Google / Facebook login"
msgstr "Google / Facebook लॉगिन"

msgid "Shown in the app. You log in with your email, not this."
msgstr "ऐप में दिखाया गया है। आप अपने ईमेल से लॉग इन करते हैं, इससे नहीं।"

msgid "This username is already taken."
msgstr "यह यूजरनेम पहले से ही लिया गया है।"

msgid "Username updated."
msgstr "यूजरनेम अपडेट हो गया।"

msgid "Hello from KhorochAi!"
msgstr "KhorochAi की ओर से नमस्ते!"

msgid "Thank you for using KhorochAi."
msgstr "KhorochAi का उपयोग करने के लिए धन्यवाद।"

msgid "Your email verification code is:"
msgstr "आपका ईमेल वेरिफिकेशन कोड है:"

msgid "Enter it in the KhorochAi page that is open in your browser. The code expires soon."
msgstr "इसे अपने ब्राउज़र में खुले KhorochAi पेज पर दर्ज करें। कोड जल्द ही समाप्त हो जाएगा।"

msgid "To confirm your email, open %(activate_url)s"
msgstr "अपना ईमेल कन्फर्म करने के लिए, %(activate_url)s खोलें"

msgid "If you did not sign up for KhorochAi, you can ignore this email."
msgstr "यदि आपने KhorochAi के लिए साइन अप नहीं किया है, तो आप इस ईमेल को अनदेखा कर सकते हैं।"

msgid "Your verification code"
msgstr "आपका वेरिफिकेशन कोड"

msgid "Your password reset code is:"
msgstr "आपका पासवर्ड रीसेट कोड है:"

msgid "If you did not ask to reset your password, you can ignore this email. Your password has not changed."
msgstr "यदि आपने अपना पासवर्ड रीसेट करने के लिए नहीं कहा है, तो आप इस ईमेल को अनदेखा कर सकते हैं। आपका पासवर्ड नहीं बदला गया है।"

msgid "Your password reset code"
msgstr "आपका पासवर्ड रीसेट कोड"

msgid "Set balance"
msgstr "बैलेंस सेट करें"

msgid "Balance now"
msgstr "अभी का बैलेंस"

msgid "Balance updated: %(list)s."
msgstr "बैलेंस अपडेट किया गया: %(list)s।"

msgid "Good morning, %(name)s"
msgstr "शुभ प्रभात, %(name)s"

msgid "Good afternoon, %(name)s"
msgstr "शुभ दोपहर, %(name)s"

msgid "Good evening, %(name)s"
msgstr "शुभ संध्या, %(name)s"

msgid "Speak instead of typing"
msgstr "टाइप करने के बजाय बोलें"

msgid "Stop recording"
msgstr "रिकॉर्डिंग रोकें"

msgid "Writing what you said…"
msgstr "जो आपने कहा उसे लिख रहे हैं…"

msgid "Microphone access is blocked. Allow it in your browser settings and try again."
msgstr "माइक्रोफ़ोन एक्सेस ब्लॉक है। इसे अपने ब्राउज़र सेटिंग्स में अनुमति दें और फिर से प्रयास करें।"

msgid "That was too short. Hold on a moment and speak, then tap stop."
msgstr "यह बहुत छोटा था। थोड़ा रुकें और बोलें, फिर स्टॉप पर टैप करें।"

msgid "Could not send the recording. Check your connection and try again."
msgstr "रिकॉर्डिंग नहीं भेजी जा सकी। अपना कनेक्शन जांचें और फिर प्रयास करें।"

msgid "No recording was received."
msgstr "कोई रिकॉर्डिंग प्राप्त नहीं हुई।"

msgid "The recording is too long. Please keep it under a minute."
msgstr "रिकॉर्डिंग बहुत लंबी है। कृपया इसे एक मिनट से कम रखें।"

msgid "Couldn't turn the recording into text right now. Please try again or type it."
msgstr "अभी रिकॉर्डिंग को टेक्स्ट में नहीं बदला जा सका। कृपया पुनः प्रयास करें या टाइप करें।"

msgid "I couldn't hear anything. Please try again a little closer to the mic."
msgstr "मुझे कुछ सुनाई नहीं दिया। कृपया माइक के थोड़ा करीब आकर फिर से प्रयास करें।"

msgid "Set budget"
msgstr "बजट सेट करें"

msgid "Monthly budget set: %(list)s."
msgstr "मासिक बजट सेट किया गया: %(list)s।"

msgid "%(name)s (removed)"
msgstr "%(name)s (हटाया गया)"

msgid "Help & contact"
msgstr "मदद और संपर्क"

msgid "Everything works by typing or speaking in plain English, বাংলা or Banglish. You always see a preview before anything is saved."
msgstr "सब कुछ साधारण English, বাংলা या Banglish में टाइप करके या बोलकर काम करता है। कुछ भी सेव होने से पहले आप हमेशा एक पूर्वावलोकन देखते हैं।"

msgid "How to use KhorochAi"
msgstr "KhorochAi का उपयोग कैसे करें"

msgid "Good to know"
msgstr "जानकर अच्छा लगा"

msgid "The AI only reads your text; every total and balance is calculated by the app from your saved data."
msgstr "AI केवल आपके टेक्स्ट को पढ़ता है; हर टोटल और बैलेंस ऐप द्वारा आपके सेव किए गए डेटा से कैलकुलेट किया जाता है।"

msgid "AI use has a daily allowance, shown on the dashboard. It resets at midnight, and you can always add things manually."
msgstr "AI के इस्तेमाल की एक दैनिक सीमा है, जो डैशबोर्ड पर दिखती है। यह आधी रात को रीसेट हो जाती है, और आप हमेशा चीज़ें मैन्युअली जोड़ सकते हैं।"

msgid "Never type card numbers or passwords."
msgstr "कभी भी कार्ड नंबर या पासवर्ड टाइप न करें।"

msgid "Change the theme, language and your username from the menu at the top right."
msgstr "ऊपर दाईं ओर स्थित मेनू से थीम, भाषा और अपना उपयोगकर्ता नाम बदलें।"

msgid "Contact"
msgstr "संपर्क"

msgid "Questions, problems or ideas"
msgstr "सवाल, समस्याएँ या सुझाव"

msgid "Write to us and we'll get back to you."
msgstr "हमें लिखें और हम आपसे संपर्क करेंगे।"

msgid "Developer"
msgstr "डेवलपर"

msgid "KhorochAi is built by %(name)s."
msgstr "KhorochAi को %(name)s द्वारा बनाया गया है।"

msgid "Account menu"
msgstr "खाता मेनू"

msgid "First name"
msgstr "पहला नाम"

msgid "Shown in the greeting and the menu."
msgstr "ग्रीटिंग और मेनू में दिखाया गया है।"

msgid "Profile updated."
msgstr "प्रोफ़ाइल अपडेट हो गई।"

msgid "Add spending or income"
msgstr "खर्च या आय जोड़ें"

msgid "Type what happened in the box on the dashboard and press Add with AI."
msgstr "डैशबोर्ड पर दिए गए बॉक्स में टाइप करें कि क्या हुआ और Add with AI दबाएं।"

msgid "Tap the mic in the box, talk, then tap stop. Check the text, then press Add with AI."
msgstr "बॉक्स में माइक पर टैप करें, बोलें, फिर स्टॉप पर टैप करें। टेक्स्ट की जांच करें, फिर AI के साथ जोड़ें पर दबाएं।"

msgid "Accounts and moving money"
msgstr "खाते और पैसों का लेन-देन"

msgid "Say which account you used, or move money between your own accounts."
msgstr "बताएं कि आपने किस अकाउंट का उपयोग किया, या अपने अकाउंट्स के बीच पैसे ट्रांसफर करें।"

msgid "Set an account balance"
msgstr "अकाउंट बैलेंस सेट करें"

msgid "Tell the AI how much is in an account right now."
msgstr "AI को बताएं कि अभी अकाउंट में कितने पैसे हैं।"

msgid "Monthly budgets"
msgstr "मासिक बजट"

msgid "Set a spending limit for a category and watch the progress bar on the dashboard."
msgstr "किसी कैटेगरी के लिए खर्च की सीमा तय करें और डैशबोर्ड पर प्रोग्रेस बार देखें।"

msgid "Ask about your money"
msgstr "अपने पैसों के बारे में पूछें"

msgid "Use Ask AI for totals, breakdowns and comparisons."
msgstr "कुल राशि, ब्रेकडाउन और तुलना के लिए Ask AI का उपयोग करें।"

msgid "Portfolio"
msgstr "पोर्टफोलियो"

msgid "Help"
msgstr "मदद"

msgid "About & contact"
msgstr "हमारे बारे में और संपर्क"

msgid "Made by"
msgstr "द्वारा बनाया गया"

msgid "Developer, KhorochAi"
msgstr "डेवलपर, KhorochAi"

msgid "How can we help?"
msgstr "हम आपकी क्या मदद कर सकते हैं?"

msgid "Still need help?"
msgstr "क्या अभी भी मदद चाहिए?"

msgid "Write to us — questions, problems and ideas are all welcome."
msgstr "हमें लिखें — सवाल, समस्याएं और सुझाव सभी का स्वागत है।"

msgid "Contact us"
msgstr "हमसे संपर्क करें"

msgid "Money tracking that speaks your language"
msgstr "मनी ट्रैकिंग जो आपकी भाषा समझती है"

msgid "KhorochAi lets you track spending and income just by typing or speaking — in English, বাংলা or Banglish. The AI understands what you mean; the app does all the maths."
msgstr "KhorochAi आपको English, বাংলা या Banglish में टाइप करके या बोलकर खर्च और आय को ट्रैक करने देता है। AI समझता है कि आपका क्या मतलब है; ऐप सारा हिसाब कर देता है।"

msgid "Type or talk"
msgstr "टाइप करें या बोलें"

msgid "No forms to fill. Say “aaj lunch 250 bkash e” and it's recorded."
msgstr "कोई फॉर्म भरने की जरूरत नहीं। बस कहें “aaj lunch 250 bkash e” और यह रिकॉर्ड हो जाएगा।"

msgid "See where it goes"
msgstr "देखें पैसा कहाँ जा रहा है"

msgid "Accounts, budgets and charts show your money at a glance, and Ask AI answers your questions."
msgstr "खाते, बजट और चार्ट आपके पैसों का एक नज़र में विवरण दिखाते हैं, और Ask AI आपके सवालों के जवाब देता है।"

msgid "Correct by design"
msgstr "डिज़ाइन द्वारा सही"

msgid "You check every entry before it's saved, and totals are always calculated from your own data."
msgstr "आप सेव होने से पहले हर एंट्री चेक करते हैं, और कुल राशि हमेशा आपके अपने डेटा से कैलकुलेट की जाती है।"

msgid "Questions, problems or ideas — write to us and we'll get back to you."
msgstr "सवाल, समस्याएँ या सुझाव — हमें लिखें और हम आपसे संपर्क करेंगे।"

msgid "Read the help guide"
msgstr "हेल्प गाइड पढ़ें"

msgid "KhorochAi — Expense & income tracker you can talk to"
msgstr "KhorochAi — खर्च और आय ट्रैकर जिससे आप बात कर सकते हैं"

msgid "Just say it. Your hisab is done."
msgstr "बस बोलें। आपका हिसाब हो गया।"

msgid "Just say it. Your hisab is done. Track spending and income by typing or speaking in English, বাংলা or Banglish."
msgstr "बस बोलें। आपका हिसाब हो गया। English, বাংলা या Banglish में टाइप करके या बोलकर खर्च और आय को ट्रैक करें।"

msgid "Free · English, বাংলা & Banglish"
msgstr "निःशुल्क · English, বাংলা & Banglish"

msgid "Type or speak what you spent or earned — like you'd tell a friend. KhorochAi turns it into neat entries, keeps your accounts and budgets up to date, and answers your money questions."
msgstr "जो आपने खर्च किया या कमाया उसे टाइप करें या बोलें — जैसे आप किसी दोस्त को बताते हैं। KhorochAi इसे सही एंट्री में बदल देता है, आपके खातों और बजट को अपडेट रखता है, और आपके पैसों से जुड़े सवालों के जवाब देता है।"

msgid "Create free account"
msgstr "मुफ्त खाता बनाएं"

msgid "Sign up with your email. You check every entry before it's saved."
msgstr "अपने ईमेल से साइन अप करें। सेव होने से पहले आप हर एंट्री की जांच कर सकते हैं।"

msgid "Write it the way you talk"
msgstr "वैसे ही लिखें जैसे आप बात करते हैं"

msgid "One message can hold several entries — spending, income, transfers between your accounts, even budgets. The AI reads it; you check the preview and save."
msgstr "एक संदेश में कई एंट्री हो सकती हैं — खर्च, आय, खातों के बीच ट्रांसफर, यहाँ तक कि बजट भी। KhorochAi इसे पढ़ता है; आप प्रीव्यू चेक करें और सेव करें।"

msgid "How it works"
msgstr "यह कैसे काम करता है"

msgid "Type or say it"
msgstr "टाइप करें या बोलें"

msgid "Write or speak what happened, in English, বাংলা or Banglish. Several things in one message is fine."
msgstr "क्या हुआ, उसे इंग्लिश, বাংলা या Banglish में लिखें या बोलें। एक मैसेज में कई चीजें बताना ठीक है।"

msgid "Check the preview"
msgstr "पूर्वावलोकन (preview) देखें"

msgid "See exactly what the AI understood — amount, category, account and date. Fix anything with a tap."
msgstr "देखें कि AI ने क्या समझा — राशि, कैटेगरी, अकाउंट और तारीख। किसी भी चीज़ को टैप करके ठीक करें।"

msgid "Saved and up to date"
msgstr "सेव किया गया और अपडेटेड है"

msgid "Your totals, account balances, budgets and charts update instantly."
msgstr "आपका टोटल, अकाउंट बैलेंस, बजट और चार्ट तुरंत अपडेट हो जाते हैं।"

msgid "Everything you need, nothing you don't"
msgstr "आपकी ज़रूरत की हर चीज़, फालतू कुछ भी नहीं"

msgid "Voice input"
msgstr "वॉयस इनपुट"

msgid "Tap the mic and speak. Your words appear in the box for you to check."
msgstr "माइक पर टैप करें और बोलें। आपके शब्द जांचने के लिए बॉक्स में दिखाई देंगे।"

msgid "Your language"
msgstr "आपकी भाषा"

msgid "English, বাংলা or Banglish — and the whole app can switch to Bangla."
msgstr "English, বাংলা या Banglish — और पूरा ऐप बांग्ला में बदल सकता है।"

msgid "All your accounts"
msgstr "आपके सभी खाते"

msgid "Cash, bKash, Nagad, Rocket, bank and card, with transfers between them."
msgstr "Cash, bKash, Nagad, Rocket, बैंक और कार्ड, इनके बीच पैसों का ट्रांसफर।"

msgid "Set limits per category and watch the progress bars as you spend."
msgstr "कैटेगरी के अनुसार सीमा तय करें और खर्च करते समय प्रोग्रेस बार देखें।"

msgid "“এই মাসে খাবারে কত খরচ হলো?” — get the answer from your own data."
msgstr "“এই মাসে খাবারে কত খরচ হলো?” — अपने डेटा से जवाब पाएं।"

msgid "Clear dashboard"
msgstr "डैशबोर्ड साफ़ करें"

msgid "Income, expense, balance, where your money went and day-by-day charts."
msgstr "आय, खर्च, बैलेंस, आपका पैसा कहाँ गया और दैनिक चार्ट।"

msgid "Light and dark"
msgstr "लाइट और डार्क"

msgid "A calm design that follows your phone's dark mode, or pick your own."
msgstr "एक शांत डिज़ाइन जो आपके फोन के डार्क मोड के अनुसार चलता है, या अपना खुद का चुनें।"

msgid "Export to CSV"
msgstr "CSV में एक्सपोर्ट करें"

msgid "Download your transactions for Excel or Google Sheets any time."
msgstr "अपने लेनदेन को किसी भी समय Excel या Google Sheets के लिए डाउनलोड करें।"

msgid "Start your hisab in a minute"
msgstr "एक मिनट में अपना हिसाब शुरू करें"

msgid "Create a free account with your email, then just tell KhorochAi what you spent today."
msgstr "अपने ईमेल से एक मुफ्त खाता बनाएं, फिर बस KhorochAi को बताएं कि आपने आज क्या खर्च किया।"

msgid "See how it works"
msgstr "देखें यह कैसे काम करता है"

msgid "Free to use"
msgstr "उपयोग करने के लिए निःशुल्क"

msgid "You confirm every entry"
msgstr "आप हर एंट्री कन्फर्म करते हैं"

msgid "Works on phone and computer"
msgstr "फोन और कंप्यूटर पर काम करता है"

msgid "Write it the way you talk — or just talk."
msgstr "वैसे ही लिखें जैसे आप बात करते हैं — या बस बोलें।"

msgid "Type it, or tap the mic and say it. One message can hold several entries — spending, income, transfers between your accounts, even budgets. You check the preview and save."
msgstr "इसे टाइप करें, या माइक पर टैप करके बोलें। एक मैसेज में कई एंट्री हो सकती हैं — खर्च, कमाई, आपके खातों के बीच ट्रांसफर, यहाँ तक कि बजट भी। आप प्रीव्यू चेक करें और सेव करें।"

msgid "Free · বাংলা, English, Banglish & any language"
msgstr "निःशुल्क · বাংলা, English, Banglish & कोई भी भाषा"

msgid "Write it the way you talk — in any language, or just talk."
msgstr "वैसे ही लिखें जैसे आप बात करते हैं — किसी भी भाषा में, या बस बोलें।"

msgid "Bangla, English, Banglish — or any language you speak. The app itself comes in 9 languages."
msgstr "Bangla, English, Banglish — या कोई भी भाषा जो आप बोलते हैं। ऐप खुद 9 भाषाओं में उपलब्ध है।"

msgid "Tell me what you spent or earned — বাংলা, English, Banglish or any language"
msgstr "मुझे बताएं कि आपने क्या खर्च किया या कमाया — বাংলা, English, Banglish या कोई भी भाषा"

msgid "Currency"
msgstr "मुद्रा"

msgid "Used for every amount in the app."
msgstr "ऐप में हर राशि के लिए इस्तेमाल किया जाता है।"

msgid "or"
msgstr "या"

msgid "Debts"
msgstr "कर्ज"

msgid "Owed to me"
msgstr "मुझे मिलना बाकी है"

msgid "I owe"
msgstr "मुझे देना है"

msgid "I borrowed"
msgstr "मैंने उधार लिया"

msgid "I lent"
msgstr "मैंने उधार दिया"

msgid "Money you lent to people or borrowed from them. Lending takes money out of an account and borrowing puts it in, so balances stay right — but it is not counted as income or expense. You can also tell the AI: “rahim ke 500 dhar dilam”, “karim theke 2000 dhar nilam”, “rahim 300 ferot dilo”."
msgstr "वह पैसा जो आपने लोगों को उधार दिया है या उनसे लिया है। उधार देने से खाते से पैसे निकलते हैं और लेने से जमा होते हैं, इसलिए बैलेंस सही रहता है — लेकिन इसे आय या खर्च के रूप में नहीं गिना जाता। आप AI को यह भी बता सकते हैं: “rahim ke 500 dhar dilam”, “karim theke 2000 dhar nilam”, “rahim 300 ferot dilo”।"

msgid "Active"
msgstr "सक्रिय"

msgid "Closed"
msgstr "बंद किया गया"

msgid "No closed debts yet. A debt closes by itself when it is fully paid back."
msgstr "अभी तक कोई बंद कर्ज नहीं है। पूरा भुगतान होने पर कर्ज अपने आप बंद हो जाता है।"

msgid "No active debts. Nobody owes you and you owe nobody."
msgstr "कोई सक्रिय कर्ज नहीं है। न तो किसी को आपको देना है और न ही आपको किसी को देना है।"

msgid "Nothing here."
msgstr "यहाँ कुछ नहीं है।"

msgid "All debts"
msgstr "सभी कर्ज"

msgid "Owes you"
msgstr "आपकी तरफ बाकी है"

msgid "You owe"
msgstr "आप पर बकाया है"

msgid "Paid back"
msgstr "चुका दिया"

msgid "Overdue"
msgstr "समय सीमा समाप्त"

msgid "Left to pay back"
msgstr "चुकाना बाकी है"

msgid "Pay back by"
msgstr "तक चुकाना है"

msgid "Record money you got back"
msgstr "वापस मिले पैसे दर्ज करें"

msgid "Record money you paid back"
msgstr "चुकाए गए पैसे दर्ज करें"

msgid "“Paid back” adds the money to the account. “Added to debt” is when you lend them more."
msgstr "\"वापस किया\" खाते में पैसे जोड़ता है। \"कर्ज में जोड़ा\" तब होता है जब आप उन्हें और उधार देते हैं।"

msgid "“Paid back” takes the money out of the account. “Added to debt” is when you borrow more."
msgstr "\"वापस किया\" खाते से पैसे निकालता है। \"कर्ज में जोड़ा\" तब होता है जब आप और उधार लेते हैं।"

msgid "History"
msgstr "इतिहास"

msgid "Lent"
msgstr "उधार दिया"

msgid "Borrowed"
msgstr "उधार लिया"

msgid "+ is money that came into your account, − is money that left it."
msgstr "+ वह पैसा है जो आपके खाते में आया, − वह पैसा है जो उससे बाहर गया।"

msgid "Reopen debt"
msgstr "कर्ज फिर से खोलें"

msgid "Close this debt without recording a payment? Use this if it was forgiven or settled another way. Balances will not change."
msgstr "भुगतान दर्ज किए बिना इस कर्ज को बंद करें? यदि इसे माफ कर दिया गया है या किसी अन्य तरीके से निपटाया गया है तो इसका उपयोग करें। बैलेंस नहीं बदलेगा।"

msgid "Close without payment"
msgstr "बिना भुगतान के बंद करें"

msgid "%(paid)s of %(total)s paid back"
msgstr "%(total)s में से %(paid)s चुका दिया गया"

msgid "Got paid back"
msgstr "रुपये वापस मिल गए"

msgid "I paid back"
msgstr "मैंने चुकाया"

msgid "Person"
msgstr "व्यक्ति"

msgid "left"
msgstr "शेष"

msgid "Was due %(day)s"
msgstr "%(day)s को देय था"

msgid "Due %(day)s"
msgstr "देय %(day)s"

msgid "of %(total)s"
msgstr "कुल %(total)s में से"

msgid "Open"
msgstr "खोलें"

msgid "e.g. Rahim"
msgstr "उदा. रहीम"

msgid "e.g. for his phone, till salary day"
msgstr "उदा. उसके फोन के लिए, सैलरी के दिन तक"

msgid "Where the money went out of (lent) or came into (borrowed). Its balance changes."
msgstr "पैसा कहाँ से निकला (उधार दिया) या आया (उधार लिया)। इसका बैलेंस बदलता है।"

msgid "Optional."
msgstr "वैकल्पिक।"

msgid "The pay-back date can't be before the date of the debt."
msgstr "वापسی की तारीख, कर्ज की तारीख से पहले नहीं हो सकती।"

msgid "Only %(left)s is left to pay back."
msgstr "चुकाने के लिए केवल %(left)s बचे हैं।"

msgid "Added to debt"
msgstr "कर्ج में जोड़ा गया"

msgid "The money left or came into this account."
msgstr "इस खाते में पैसे बचे या आए।"

msgid "Lend and borrow"
msgstr "लेन-देन"

msgid "Keep track of money you lent or borrowed. Account balances change, but it is not counted as income or expense."
msgstr "अपने दिए या लिए गए उधार का हिसाब रखें। खाते का बैलेंस बदलता है, लेकिन इसे आय या खर्च के रूप में नहीं गिना जाता।"

msgid "Lent %(amount)s to %(person)s."
msgstr "%(person)s को %(amount)s उधार दिए।"

msgid "Borrowed %(amount)s from %(person)s."
msgstr "%(person)s से %(amount)s उधार लिए।"

msgid "%(person)s doesn't owe you anything, so the %(amount)s payment was not saved."
msgstr "%(person)s को आपको कुछ नहीं देना है, इसलिए %(amount)s का भुगतान सेव नहीं किया गया।"

msgid "You don't owe %(person)s anything, so the %(amount)s payment was not saved."
msgstr "आप %(person)s के कुछ भी नहीं, इसलिए %(amount)s का भुगतान सहेजा नहीं गया।"

msgid "%(person)s paid you back %(amount)s."
msgstr "%(person)s ने आपको %(amount)s वापस लौटा दिए।"

msgid "You paid %(person)s back %(amount)s."
msgstr "आपने %(person)s को %(amount)s वापस कर दिए।"

msgid "Debt saved."
msgstr "कर्ज सेव हो गया।"

msgid "Add debt"
msgstr "कर्ज जोड़ें"

msgid "Fully paid back. The debt is closed."
msgstr "पूरा भुगतान हो चुका है। कर्ज बंद है।"

msgid "Saved. %(left)s left."
msgstr "सहेजा गया। %(left)s शेष है।"

msgid "Debt updated."
msgstr "कर्ज अपडेट कर दिया गया।"

msgid "Edit debt"
msgstr "कर्ज एडिट करें"

msgid "Debt deleted. Its payments were removed too."
msgstr "कर्ज हटा दिया गया। इसके भुगतान भी हटा दिए गए हैं।"

msgid "Debt closed."
msgstr "कर्ज बंद कर दिया गया।"

msgid "Debt reopened."
msgstr "कर्ज फिर से खोल दिया गया।"

msgid "Payment updated."
msgstr "भुगतान अपडेट कर दिया गया।"

msgid "Edit payment"
msgstr "भुगतान एडिट करें"

msgid "Payment deleted."
msgstr "भुगतान हटा दिया गया।"

msgid "The AI found %(n)s transaction. Fix anything that looks wrong, then save."
msgid_plural "The AI found %(n)s transactions. Fix anything that looks wrong, then save."
msgstr[0] "AI ने %(n)s ट्रांजेक्शन पाया। जो गलत लगे उसे ठीक करें, फिर सेव करें।"
msgstr[1] "AI ने %(n)s ट्रांजेक्शन पाए। जो गलत लगे उसे ठीक करें, फिर सेव करें।"

msgid "%(n)s transaction"
msgid_plural "%(n)s transactions"
msgstr[0] "%(n)s लेनदेन"
msgstr[1] "%(n)s लेनदेन"

msgid "Saved %(n)s transaction."
msgid_plural "Saved %(n)s transactions."
msgstr[0] "%(n)s ट्रांजेक्शन सेव किया गया।"
msgstr[1] "%(n)s ट्रांजेक्शन सेव किए गए।"

msgid "This password is too short. It must contain at least %d character."
msgid_plural "This password is too short. It must contain at least %d characters."
msgstr[0] "यह पासवर्ड बहुत छोटा है। इसमें कम से कम %d अक्षर होना चाहिए।"
msgstr[1] "यह पासवर्ड बहुत छोटा है। इसमें कम से कम %d अक्षर होने चाहिए।"

msgid "Your password must contain at least %(min_length)d character."
msgid_plural "Your password must contain at least %(min_length)d characters."
msgstr[0] "आपके पासवर्ड में कम से कम %(min_length)d अक्षर होना चाहिए।"
msgstr[1] "आपके पासवर्ड में कम से कम %(min_length)d अक्षर होने चाहिए।"

msgid "%(n)s overdue"
msgid_plural "%(n)s overdue"
msgstr[0] "%(n)s का समय निकल चुका है"
msgstr[1] "%(n)s का समय निकल चुका है"

msgid "%(n)s debt"
msgid_plural "%(n)s debts"
msgstr[0] "%(n)s का कर्ज"
msgstr[1] "%(n)s के कर्ज"

msgid "%(n)s debt is past its pay-back date."
msgid_plural "%(n)s debts are past their pay-back date."
msgstr[0] "%(n)s का कर्ज चुकाने की तारीख निकल चुकी है।"
msgstr[1] "%(n)s के कर्ज चुकाने की तारीख निकल चुकी है।"
