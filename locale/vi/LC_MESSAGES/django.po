msgstr "Mật khẩu của bạn không được là mật khẩu phổ biến."

msgid "Your password can’t be entirely numeric."
msgstr "Mật khẩu của bạn không được chỉ bao gồm các con số."

msgid "Continue with %(provider)s"
msgstr "Tiếp tục với %(provider)s"

msgid "or with email"
msgstr "hoặc bằng email"

msgid "You'll get ready-made categories and accounts to start with. We'll email you a 6-digit code to confirm your email."
msgstr "Bạn sẽ nhận được các danh mục và tài khoản có sẵn để bắt đầu. Chúng tôi sẽ gửi mã 6 chữ số qua email để xác nhận địa chỉ email của bạn."

msgid "Profile"
msgstr "Hồ sơ"

msgid "Email (used to log in)"
msgstr "Email (dùng để đăng nhập)"

msgid "Change email"
msgstr "Đổi email"

msgid "Change password"
msgstr "Đổi mật khẩu"

msgid "Google / Facebook login"
msgstr "Đăng nhập bằng Google / Facebook"

msgid "Shown in the app. You log in with your email, not this."
msgstr "Hiển thị trong ứng dụng. Bạn đăng nhập bằng email, không phải cái này."

msgid "This username is already taken."
msgstr "Tên người dùng này đã được sử dụng."

msgid "Username updated."
msgstr "Đã cập nhật tên người dùng."

msgid "Hello from KhorochAi!"
msgstr "Xin chào từ KhorochAi!"

msgid "Thank you for using KhorochAi."
msgstr "Cảm ơn bạn đã sử dụng KhorochAi."

msgid "Your email verification code is:"
msgstr "Mã xác minh email của bạn là:"

msgid "Enter it in the KhorochAi page that is open in your browser. The code expires soon."
msgstr "Nhập mã đó vào trang KhorochAi đang mở trong trình duyệt của bạn. Mã sẽ sớm hết hạn."

msgid "To confirm your email, open %(activate_url)s"
msgstr "Để xác nhận email, hãy mở %(activate_url)s"

msgid "If you did not sign up for KhorochAi, you can ignore this email."
msgstr "Nếu bạn không đăng ký KhorochAi, bạn có thể bỏ qua email này."

msgid "Your verification code"
msgstr "Mã xác minh của bạn"

msgid "Your password reset code is:"
msgstr "Mã đặt lại mật khẩu của bạn là:"

msgid "If you did not ask to reset your password, you can ignore this email. Your password has not changed."
msgstr "Nếu bạn không yêu cầu đặt lại mật khẩu, bạn có thể bỏ qua email này. Mật khẩu của bạn không thay đổi."

msgid "Your password reset code"
msgstr "Mã đặt lại mật khẩu của bạn"

msgid "Set balance"
msgstr "Đặt số dư"

msgid "Balance now"
msgstr "Số dư hiện tại"

msgid "Balance updated: %(list)s."
msgstr "Số dư đã cập nhật: %(list)s."

msgid "Good morning, %(name)s"
msgstr "Chào buổi sáng, %(name)s"

msgid "Good afternoon, %(name)s"
msgstr "Chào buổi chiều, %(name)s"

msgid "Good evening, %(name)s"
msgstr "Chào buổi tối, %(name)s"

msgid "Speak instead of typing"
msgstr "Nói thay vì gõ"

msgid "Stop recording"
msgstr "Dừng ghi âm"

msgid "Writing what you said…"
msgstr "Đang ghi lại những gì bạn nói…"

msgid "Microphone access is blocked. Allow it in your browser settings and try again."
msgstr "Quyền truy cập micrô bị chặn. Hãy cho phép trong cài đặt trình duyệt của bạn và thử lại."

msgid "That was too short. Hold on a moment and speak, then tap stop."
msgstr "Quá ngắn. Hãy đợi một chút rồi nói, sau đó chạm dừng."

msgid "Could not send the recording. Check your connection and try again."
msgstr "Không thể gửi bản ghi. Kiểm tra kết nối của bạn và thử lại."

msgid "No recording was received."
msgstr "Không nhận được bản ghi nào."

msgid "The recording is too long. Please keep it under a minute."
msgstr "Bản ghi âm quá dài. Vui lòng giữ dưới một phút."

msgid "Couldn't turn the recording into text right now. Please try again or type it."
msgstr "Hiện không thể chuyển bản ghi thành văn bản. Vui lòng thử lại hoặc nhập văn bản."

msgid "I couldn't hear anything. Please try again a little closer to the mic."
msgstr "Tôi không nghe thấy gì cả. Vui lòng thử lại gần mic hơn."

msgid "Set budget"
msgstr "Đặt ngân sách"

msgid "Monthly budget set: %(list)s."
msgstr "Đã đặt ngân sách hàng tháng: %(list)s."

msgid "%(name)s (removed)"
msgstr "%(name)s (đã xóa)"

msgid "Help & contact"
msgstr "Trợ giúp & liên hệ"

msgid "Everything works by typing or speaking in plain English, বাংলা or Banglish. You always see a preview before anything is saved."
msgstr "Mọi thứ hoạt động bằng cách nhập hoặc nói bằng tiếng Anh, বাংলা hoặc Banglish đơn giản. Bạn luôn thấy bản xem trước trước khi bất kỳ thứ gì được lưu."

msgid "How to use KhorochAi"
msgstr "Cách sử dụng KhorochAi"

msgid "Good to know"
msgstr "Thông tin hữu ích"

msgid "The AI only reads your text; every total and balance is calculated by the app from your saved data."
msgstr "AI chỉ đọc văn bản của bạn; mọi tổng số và số dư đều được ứng dụng tính toán từ dữ liệu đã lưu."

msgid "AI use has a daily allowance, shown on the dashboard. It resets at midnight, and you can always add things manually."
msgstr "AI có hạn mức sử dụng hàng ngày, được hiển thị trên bảng điều khiển. Hạn mức này sẽ đặt lại vào lúc nửa đêm và bạn luôn có thể thêm các mục theo cách thủ công."

msgid "Never type card numbers or passwords."
msgstr "Không bao giờ nhập số thẻ hoặc mật khẩu."

msgid "Change the theme, language and your username from the menu at the top right."
msgstr "Thay đổi chủ đề, ngôn ngữ và tên người dùng của bạn từ menu ở góc trên bên phải."

msgid "Contact"
msgstr "Liên hệ"

msgid "Questions, problems or ideas"
msgstr "Câu hỏi, vấn đề hoặc ý tưởng"

msgid "Write to us and we'll get back to you."
msgstr "Viết cho chúng tôi và chúng tôi sẽ phản hồi lại bạn."

msgid "Developer"
msgstr "Nhà phát triển"

msgid "KhorochAi is built by %(name)s."
msgstr "KhorochAi được xây dựng bởi %(name)s."

msgid "Account menu"
msgstr "Menu tài khoản"

msgid "First name"
msgstr "Tên"

msgid "Shown in the greeting and the menu."
msgstr "Hiển thị trong lời chào và menu."

msgid "Profile updated."
msgstr "Hồ sơ đã được cập nhật."

msgid "Add spending or income"
msgstr "Thêm chi tiêu hoặc thu nhập"

msgid "Type what happened in the box on the dashboard and press Add with AI."
msgstr "Nhập những gì đã xảy ra vào ô trên bảng điều khiển và nhấn Thêm bằng AI."

msgid "Tap the mic in the box, talk, then tap stop. Check the text, then press Add with AI."
msgstr "Chạm vào mic trong hộp, nói, sau đó chạm dừng. Kiểm tra văn bản, rồi nhấn Thêm bằng AI."

msgid "Accounts and moving money"
msgstr "Tài khoản và chuyển tiền"

msgid "Say which account you used, or move money between your own accounts."
msgstr "Cho biết bạn đã dùng tài khoản nào hoặc chuyển tiền giữa các tài khoản của bạn."

msgid "Set an account balance"
msgstr "Đặt số dư tài khoản"

msgid "Tell the AI how much is in an account right now."
msgstr "Cho AI biết số dư hiện tại của tài khoản."

msgid "Monthly budgets"
msgstr "Ngân sách hàng tháng"

msgid "Set a spending limit for a category and watch the progress bar on the dashboard."
msgstr "Đặt giới hạn chi tiêu cho một danh mục và theo dõi thanh tiến trình trên bảng điều khiển."

msgid "Ask about your money"
msgstr "Hỏi về tiền của bạn"

msgid "Use Ask AI for totals, breakdowns and comparisons."
msgstr "Sử dụng Ask AI để xem tổng số, phân tích và so sánh."

msgid "Portfolio"
msgstr "Danh mục đầu tư"

msgid "Help"
msgstr "Trợ giúp"

msgid "About & contact"
msgstr "Giới thiệu & liên hệ"

msgid "Made by"
msgstr "Được tạo bởi"

msgid "Developer, KhorochAi"
msgstr "Nhà phát triển, KhorochAi"

msgid "How can we help?"
msgstr "Chúng tôi có thể giúp gì cho bạn?"

msgid "Still need help?"
msgstr "Bạn vẫn cần trợ giúp?"

msgid "Write to us — questions, problems and ideas are all welcome."
msgstr "Viết cho chúng tôi — mọi câu hỏi, vấn đề và ý tưởng đều được hoan nghênh."

msgid "Contact us"
msgstr "Liên hệ với chúng tôi"

msgid "Money tracking that speaks your language"
msgstr "Quản lý tài chính bằng ngôn ngữ của bạn"

msgid "KhorochAi lets you track spending and income just by typing or speaking — in English, বাংলা or Banglish. The AI understands what you mean; the app does all the maths."
msgstr "KhorochAi cho phép bạn theo dõi chi tiêu và thu nhập chỉ bằng cách nhập hoặc nói — bằng tiếng Anh, বাংলা hoặc Banglish. AI hiểu ý bạn; ứng dụng sẽ thực hiện tất cả các phép tính."

msgid "Type or talk"
msgstr "Nhập hoặc nói"

msgid "No forms to fill. Say “aaj lunch 250 bkash e” and it's recorded."
msgstr "Không cần điền biểu mẫu. Chỉ cần nói “aaj lunch 250 bkash e” và giao dịch sẽ được ghi lại."

msgid "See where it goes"
msgstr "Xem tiền đi đâu"

msgid "Accounts, budgets and charts show your money at a glance, and Ask AI answers your questions."
msgstr "Tài khoản, ngân sách và biểu đồ giúp bạn xem nhanh tình hình tài chính, và Ask AI sẽ trả lời các câu hỏi của bạn."

msgid "Correct by design"
msgstr "Thiết kế chuẩn xác"

msgid "You check every entry before it's saved, and totals are always calculated from your own data."
msgstr "Bạn kiểm tra mọi mục trước khi lưu và tổng số luôn được tính toán từ dữ liệu của chính bạn."

msgid "Questions, problems or ideas — write to us and we'll get back to you."
msgstr "Câu hỏi, vấn đề hoặc ý tưởng — hãy viết cho chúng tôi và chúng tôi sẽ phản hồi lại bạn."

msgid "Read the help guide"
msgstr "Đọc hướng dẫn trợ giúp"

msgid "KhorochAi — Expense & income tracker you can talk to"
msgstr "KhorochAi — Ứng dụng theo dõi chi tiêu & thu nhập mà bạn có thể trò chuyện"

msgid "Just say it. Your hisab is done."
msgstr "Chỉ cần nói ra. Hisab của bạn đã xong."

msgid "Just say it. Your hisab is done. Track spending and income by typing or speaking in English, বাংলা or Banglish."
msgstr "Chỉ cần nói ra. Hisab của bạn đã xong. Theo dõi chi tiêu và thu nhập bằng cách nhập hoặc nói bằng tiếng Anh, বাংলা hoặc Banglish."

msgid "Free · English, বাংলা & Banglish"
msgstr "Miễn phí · Tiếng Anh, বাংলা & Banglish"

msgid "Type or speak what you spent or earned — like you'd tell a friend. KhorochAi turns it into neat entries, keeps your accounts and budgets up to date, and answers your money questions."
msgstr "Nhập hoặc nói những gì bạn đã chi hoặc kiếm được — như cách bạn kể với bạn bè. KhorochAi sẽ chuyển nó thành các mục gọn gàng, cập nhật tài khoản và ngân sách của bạn, đồng thời trả lời các câu hỏi về tiền bạc của bạn."

msgid "Create free account"
msgstr "Tạo tài khoản miễn phí"

msgid "Sign up with your email. You check every entry before it's saved."
msgstr "Đăng ký bằng email của bạn. Bạn kiểm tra mọi mục trước khi lưu."

msgid "Write it the way you talk"
msgstr "Viết theo cách bạn nói"

msgid "One message can hold several entries — spending, income, transfers between your accounts, even budgets. The AI reads it; you check the preview and save."
msgstr "Một tin nhắn có thể chứa nhiều mục — chi tiêu, thu nhập, chuyển khoản giữa các tài khoản, thậm chí cả ngân sách. AI sẽ đọc tin nhắn đó; bạn chỉ cần kiểm tra bản xem trước và lưu lại."

msgid "How it works"
msgstr "Cách hoạt động"

msgid "Type or say it"
msgstr "Nhập hoặc nói"

msgid "Write or speak what happened, in English, বাংলা or Banglish. Several things in one message is fine."
msgstr "Viết hoặc nói những gì đã xảy ra, bằng tiếng Anh, বাংলা hoặc Banglish. Nhiều mục trong một tin nhắn đều được."

msgid "Check the preview"
msgstr "Kiểm tra bản xem trước"

msgid "See exactly what the AI understood — amount, category, account and date. Fix anything with a tap."
msgstr "Xem chính xác những gì AI đã hiểu — số tiền, danh mục, tài khoản và ngày tháng. Chỉnh sửa bất kỳ mục nào bằng một lần chạm."

msgid "Saved and up to date"
msgstr "Đã lưu và cập nhật"

msgid "Your totals, account balances, budgets and charts update instantly."
msgstr "Tổng số dư, số dư tài khoản, ngân sách và biểu đồ của bạn được cập nhật ngay lập tức."

msgid "Everything you need, nothing you don't"
msgstr "Mọi thứ bạn cần, không có gì thừa thãi"

msgid "Voice input"
msgstr "Nhập liệu bằng giọng nói"

msgid "Tap the mic and speak. Your words appear in the box for you to check."
msgstr "Chạm vào mic và nói. Lời của bạn sẽ xuất hiện trong hộp để bạn kiểm tra."

msgid "Your language"
msgstr "Ngôn ngữ của bạn"

msgid "English, বাংলা or Banglish — and the whole app can switch to Bangla."
msgstr "English, বাংলা hoặc Banglish — và toàn bộ ứng dụng có thể chuyển sang tiếng Bangla."

msgid "All your accounts"
msgstr "Tất cả tài khoản của bạn"

msgid "Cash, bKash, Nagad, Rocket, bank and card, with transfers between them."
msgstr "Tiền mặt, bKash, Nagad, Rocket, ngân hàng và thẻ, với tính năng chuyển tiền giữa các tài khoản."

msgid "Set limits per category and watch the progress bars as you spend."
msgstr "Đặt giới hạn cho mỗi danh mục và theo dõi thanh tiến trình khi bạn chi tiêu."

msgid "“এই মাসে খাবারে কত খরচ হলো?” — get the answer from your own data."
msgstr "“এই মাসে খাবারে কত খরচ হলো?” — nhận câu trả lời từ chính dữ liệu của bạn."

msgid "Clear dashboard"
msgstr "Xóa bảng điều khiển"

msgid "Income, expense, balance, where your money went and day-by-day charts."
msgstr "Thu nhập, chi tiêu, số dư, nơi tiền của bạn đã đi và biểu đồ theo ngày."

msgid "Light and dark"
msgstr "Sáng và tối"

msgid "A calm design that follows your phone's dark mode, or pick your own."
msgstr "Thiết kế nhẹ nhàng theo chế độ tối của điện thoại, hoặc tự chọn theo ý bạn."

msgid "Export to CSV"
msgstr "Xuất sang CSV"

msgid "Download your transactions for Excel or Google Sheets any time."
msgstr "Tải xuống các giao dịch của bạn cho Excel hoặc Google Sheets bất cứ lúc nào."

msgid "Start your hisab in a minute"
msgstr "Bắt đầu quản lý tài chính của bạn trong một phút"

msgid "Create a free account with your email, then just tell KhorochAi what you spent today."
msgstr "Tạo tài khoản miễn phí bằng email của bạn, sau đó chỉ cần nói cho KhorochAi biết bạn đã chi tiêu gì hôm nay."

msgid "See how it works"
msgstr "Xem cách hoạt động"

msgid "Free to use"
msgstr "Sử dụng miễn phí"

msgid "You confirm every entry"
msgstr "Bạn xác nhận mọi mục"

msgid "Works on phone and computer"
msgstr "Hoạt động trên điện thoại và máy tính"

msgid "Write it the way you talk — or just talk."
msgstr "Viết theo cách bạn nói — hoặc chỉ cần nói."

msgid "Type it, or tap the mic and say it. One message can hold several entries — spending, income, transfers between your accounts, even budgets. You check the preview and save."
msgstr "Nhập liệu hoặc nhấn vào mic và nói. Một tin nhắn có thể chứa nhiều mục — chi tiêu, thu nhập, chuyển khoản giữa các tài khoản, thậm chí là ngân sách. Bạn kiểm tra bản xem trước rồi lưu lại."

msgid "Free · বাংলা, English, Banglish & any language"
msgstr "Miễn phí · বাংলা, Tiếng Anh, Banglish & bất kỳ ngôn ngữ nào"

msgid "Write it the way you talk — in any language, or just talk."
msgstr "Viết theo cách bạn nói — bằng bất kỳ ngôn ngữ nào, hoặc chỉ cần nói."

msgid "Bangla, English, Banglish — or any language you speak. The app itself comes in 9 languages."
msgstr "Tiếng Bangla, tiếng Anh, Banglish — hoặc bất kỳ ngôn ngữ nào bạn nói. Ứng dụng hỗ trợ 9 ngôn ngữ."

msgid "Tell me what you spent or earned — বাংলা, English, Banglish or any language"
msgstr "Cho tôi biết bạn đã chi hoặc kiếm được bao nhiêu — বাংলা, tiếng Anh, Banglish hoặc bất kỳ ngôn ngữ nào"

msgid "Currency"
msgstr "Tiền tệ"

msgid "Used for every amount in the app."
msgstr "Được sử dụng cho mọi số tiền trong ứng dụng."

msgid "The AI found %(n)s transaction. Fix anything that looks wrong, then save."
msgid_plural "The AI found %(n)s transactions. Fix anything that looks wrong, then save."
msgstr[0] "AI đã tìm thấy %(n)s giao dịch. Chỉnh sửa bất kỳ mục nào sai, rồi lưu."

msgid "%(n)s transaction"
msgid_plural "%(n)s transactions"
msgstr[0] "%(n)s giao dịch"

msgid "Saved %(n)s transaction."
msgid_plural "Saved %(n)s transactions."
msgstr[0] "Đã lưu %(n)s giao dịch."

msgid "This password is too short. It must contain at least %d character."
msgid_plural "This password is too short. It must contain at least %d characters."
msgstr[0] "Mật khẩu quá ngắn. Phải có ít nhất %d ký tự."

msgid "Your password must contain at least %(min_length)d character."
msgid_plural "Your password must contain at least %(min_length)d characters."
msgstr[0] "Mật khẩu của bạn phải chứa ít nhất %(min_length)d ký tự."

msgid "or"
msgstr "hoặc"
