msgid "Profile"
msgstr "প্রোফাইল"

msgid "Email (used to log in)"
msgstr "ইমেইল (লগ ইনের জন্য)"

msgid "Change email"
msgstr "ইমেইল বদলান"

msgid "Change password"
msgstr "পাসওয়ার্ড বদলান"

msgid "Google / Facebook login"
