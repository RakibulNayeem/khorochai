# Copy this file to .env and fill in the values. NEVER upload .env to GitHub.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
CSRF_TRUSTED_ORIGINS=https://*.vercel.app

# Database: leave empty to use local SQLite.
# For Neon, paste the *pooled* connection string, e.g.
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Optional, local only: your Neon URL, used just for commands run with USE_LIVE_DB=1 (e.g. migrate).
LIVE_DATABASE_URL=

# AI providers (free tiers). Gemini is tried first, Groq is the backup.
# Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Groq key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_PROVIDERS=gemini,groq

# Daily AI limits so the free tiers are never exceeded (resets at midnight, Bangladesh time).
# Tokens per user, and tokens + requests for the whole app. Keep the totals below your free quota.
AI_DAILY_TOKENS_PER_USER=30000
AI_DAILY_TOKENS_TOTAL=1000000
AI_DAILY_REQUESTS_TOTAL=400

# Email for verification and password-reset codes (Gmail, free ~500/day).
# EMAIL_HOST_PASSWORD is a Google "App password" (Google Account -> Security -> App passwords), not your Gmail password.
# Leave empty locally: emails are then printed in the terminal.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# "Continue with Google": Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# "Continue with Facebook": developers.facebook.com -> My Apps -> Create app -> Facebook Login.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
