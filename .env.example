# Copy this file to .env and fill in the values. NEVER upload .env to GitHub.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
CSRF_TRUSTED_ORIGINS=https://*.vercel.app

# Database: leave empty to use local SQLite.
# For Neon, paste the *pooled* connection string, e.g.
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# AI providers (free tiers). Gemini is tried first, Groq is the backup.
# Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Groq key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_PROVIDERS=gemini,groq

# Daily AI limits so the free tiers are never exceeded (resets at midnight, Bangladesh time).
# Per user, and for the whole app together. Keep the total below your free quota.
AI_DAILY_LIMIT_PER_USER=20
AI_DAILY_LIMIT_TOTAL=400
